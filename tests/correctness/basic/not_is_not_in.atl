class NotInBaseAnimal() {
	fun sound(): String = "animal"
}

class NotInDog extends NotInBaseAnimal {
	constructor() {
		super()
	}
	@override
	fun sound(): String = "bark"
}

class NotInCat extends NotInBaseAnimal {
	constructor() {
		super()
	}
	@override
	fun sound(): String = "meow"
}

class NotInCustomContainer(val data: Array<Int>) {
	operator fun contains(target: Int): Bool {
		return target in data
	}
}

fun testNotIsExpression() {
	val dog = NotInDog()
	val cat = NotInCat()

	// !is tests
	assert(dog is NotInDog, __FILE__, __LINE__)
	assert(dog is NotInBaseAnimal, __FILE__, __LINE__)
	assert(dog !is NotInCat, __FILE__, __LINE__)
	assert(cat !is NotInDog, __FILE__, __LINE__)
	assert(!(dog !is NotInBaseAnimal), __FILE__, __LINE__)
	assert(!(dog !is NotInDog), __FILE__, __LINE__)

	// !is in when expression
	val animal: NotInBaseAnimal = dog
	val animalType = when (animal) {
		!is NotInDog -> "not_dog"
		is NotInDog -> "dog"
		else -> "unknown"
	}
	assert(animalType == "dog", __FILE__, __LINE__)

	val catAnimal: NotInBaseAnimal = cat
	val catType = when (catAnimal) {
		!is NotInDog -> "not_dog"
		else -> "dog"
	}
	assert(catType == "not_dog", __FILE__, __LINE__)

	println("Passed testNotIsExpression")
}

fun testNotInExpression() {
	// !in with Range
	assert(5 in 1..10, __FILE__, __LINE__)
	assert(0 !in 1..10, __FILE__, __LINE__)
	assert(11 !in 1..10, __FILE__, __LINE__)
	assert(!(5 !in 1..10), __FILE__, __LINE__)

	// Range exclusive upper bound
	assert(10 in 1..10, __FILE__, __LINE__)
	assert(10 !in 1..<10, __FILE__, __LINE__)
	assert(9 in 1..<10, __FILE__, __LINE__)

	// !in with Array (collection with contains)
	val arr = <Int>[10, 20, 30]
	assert(20 in arr, __FILE__, __LINE__)
	assert(40 !in arr, __FILE__, __LINE__)
	assert(!(10 !in arr), __FILE__, __LINE__)

	// !in with custom class using operator contains
	val container = NotInCustomContainer(<Int>[100, 200, 300])
	assert(200 in container, __FILE__, __LINE__)
	assert(999 !in container, __FILE__, __LINE__)
	assert(!(100 !in container), __FILE__, __LINE__)

	// !in in when expression
	val score = 85
	val grade = when (score) {
		!in 0..100 -> "invalid"
		!in 50..100 -> "fail"
		else -> "pass"
	}
	assert(grade == "pass", __FILE__, __LINE__)

	val badScore = 150
	val badGrade = when (badScore) {
		!in 0..100 -> "invalid"
		else -> "valid"
	}
	assert(badGrade == "invalid", __FILE__, __LINE__)

	println("Passed testNotInExpression")
}

testNotIsExpression()
testNotInExpression()
