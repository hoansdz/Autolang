class FunctionalTest {
	var value = 5
	
	fun plus_plus() {
		value += 1
	} 
	
	constructor () {
		
	}
}

class FunctionalTestGeneric<T, R> {
	lateinit val f: (T) -> R

	fun get(): R = f(1)
	
	constructor (f: (T) -> R) {
		this.f = f
	}
}

fun testFunctionalSquare(value: Float): Int {
	return Int(value * value)
}
fun testFunctionalLoad(onLoad: (Float)->Int): Int {
	return onLoad(125)
}
fun testFunctionalEmptyParams(): Int {
	return 0
}

fun testFunctionalInput(value: Int) = "OK"

fun <T, R> testFunctional() {

	val a: Float -> Int = testFunctionalSquare
	val b = a
	val c: () -> Int = testFunctionalEmptyParams
	val d: ((Float) -> Int) -> Int = testFunctionalLoad
	val e = FunctionalTest()
	val f: () -> Void = e::plus_plus

	val g: (T) -> R = testFunctionalInput
	val h = FunctionalTestGeneric<T, R>(g)

	assert(d(b) == 15625)

	f()
	f()
	f()
	assert(e.value == 8)
	assert(h.get() == "OK")

	println("Passed ${__FUNC__}")
}

testFunctional<Int, String>()