class CustomCollection(val items: Array<Int>) {
	operator fun get(i: Int): Int {
		return items[i]
	}

	operator fun set(i: Int, value: Int) {
		items[i] = value
	}

	operator fun contains(value: Int): Bool {
		return value in items
	}
}

class AnnotatedCollection(val items: Array<String>) {
	@operator
	@operator
	fun get(i: Int): String {
		return items[i]
	}

	@operator
	fun set(i: Int, value: String) {
		items[i] = value
	}

	@operator
	fun contains(value: String): Bool {
		return value in items
	}
}

class BaseWorker {
	fun work(): String {
		return "BaseWorker"
	}
}

class DerivedWorker extends BaseWorker {
	constructor() {
		super()
	}

	override fun work(): String {
		return "DerivedWorker"
	}
}

@no_constructor
@no_constructor
class DuplicateAnnotationTest {
	static fun ping(): String {
		return "pong"
	}
}

fun <T> testGenericIdentity(x: T): T {
	return x
}

fun <T, R> testGenericTransform(x: T, fallback: R): R {
	return fallback
}

fun testOperatorOverloading() {
	// 1. Operator keyword (get, set, contains)
	val col = CustomCollection([10, 20, 30])
	assert(col[0] == 10, __FILE__, __LINE__)
	assert(col[1] == 20, __FILE__, __LINE__)
	assert(col[2] == 30, __FILE__, __LINE__)

	col[1] = 99
	assert(col[1] == 99, __FILE__, __LINE__)

	assert(99 in col, __FILE__, __LINE__)
	assert(!(100 in col), __FILE__, __LINE__)

	// 2. @operator annotation with duplicates
	val strCol = AnnotatedCollection(["alpha", "beta"])
	assert(strCol[0] == "alpha", __FILE__, __LINE__)
	assert(strCol[1] == "beta", __FILE__, __LINE__)

	strCol[0] = "gamma"
	assert(strCol[0] == "gamma", __FILE__, __LINE__)
	assert("gamma" in strCol, __FILE__, __LINE__)
	assert(!("alpha" in strCol), __FILE__, __LINE__)

	// 3. override keyword
	val worker: BaseWorker = DerivedWorker()
	assert(worker.work() == "DerivedWorker", __FILE__, __LINE__)

	// 4. Duplicate @no_constructor
	assert(DuplicateAnnotationTest.ping() == "pong", __FILE__, __LINE__)

	// 5. fun <T> Kotlin-style generic functions
	assert(testGenericIdentity<Int>(42) == 42, __FILE__, __LINE__)
	assert(testGenericIdentity<String>("hello") == "hello", __FILE__, __LINE__)
	assert(testGenericTransform<Int, String>(10, "ok") == "ok", __FILE__, __LINE__)

	println("Passed ${__FUNC__}")
}

testOperatorOverloading()
