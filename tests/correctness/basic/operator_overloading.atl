class CustomCollection(val items: Array<Int>) {
	operator fun get(i: Int): Int {
		return items[i]
	}

	operator fun set(i: Int, value: Int) {
		items[i] = value
	}

	operator fun contains(value: Int): Bool {
		return value in items
	}
}

class AnnotatedCollection(val items: Array<String>) {
	@operator
	@operator
	fun get(i: Int): String {
		return items[i]
	}

	@operator
	fun set(i: Int, value: String) {
		items[i] = value
	}

	@operator
	fun contains(value: String): Bool {
		return value in items
	}
}

class BaseWorker {
	fun work(): String {
		return "BaseWorker"
	}
}

class DerivedWorker extends BaseWorker {
	constructor() {
		super()
	}

	override fun work(): String {
		return "DerivedWorker"
	}
}

@no_constructor
@no_constructor
class DuplicateAnnotationTest {
	static fun ping(): String {
		return "pong"
	}
}

fun <T> testGenericIdentity(x: T): T {
	return x
}

class Vector2(val x: Int, val y: Int) {
	operator fun plus(other: Vector2): Vector2 {
		return Vector2(x + other.x, y + other.y)
	}

	operator fun minus(other: Vector2): Vector2 {
		return Vector2(x - other.x, y - other.y)
	}

	operator fun times(scale: Int): Vector2 {
		return Vector2(x * scale, y * scale)
	}

	operator fun div(scale: Int): Vector2 {
		return Vector2(x / scale, y / scale)
	}

	operator fun rem(scale: Int): Vector2 {
		return Vector2(x % scale, y % scale)
	}
}

fun <T, R> testGenericTransform(x: T, fallback: R): R {
	return fallback
}

class Score(val value: Int) {
	operator fun compareTo(other: Score): Int {
		return this.value - other.value
	}

	operator fun unaryMinus(): Score {
		return Score(-this.value)
	}

	operator fun unaryPlus(): Score {
		return Score(this.value)
	}

	operator fun not(): Bool {
		return this.value == 0
	}
}

fun testOperatorOverloading() {
	// 1. Operator keyword (get, set, contains)
	val col = CustomCollection([10, 20, 30])
	assert(col[0] == 10)
	assert(col[1] == 20)
	assert(col[2] == 30)

	col[1] = 99
	assert(col[1] == 99)

	assert(99 in col)
	assert(!(100 in col))

	// 2. @operator annotation with duplicates
	val strCol = AnnotatedCollection(["alpha", "beta"])
	assert(strCol[0] == "alpha")
	assert(strCol[1] == "beta")

	strCol[0] = "gamma"
	assert(strCol[0] == "gamma")
	assert("gamma" in strCol)
	assert(!("alpha" in strCol))

	// 3. Binary operator overloading (+, -, *, /, %)
	val v1 = Vector2(10, 20)
	val v2 = Vector2(3, 5)
	val vAdd = v1 + v2
	assert(vAdd.x == 13 && vAdd.y == 25)

	val vSub = v1 - v2
	assert(vSub.x == 7 && vSub.y == 15)

	val vMul = v1 * 3
	assert(vMul.x == 30 && vMul.y == 60)

	val vDiv = v1 / 2
	assert(vDiv.x == 5 && vDiv.y == 10)

	val vRem = v1 % 3
	assert(vRem.x == 1 && vRem.y == 2)

	// 4. Comparison operator overloading (compareTo -> <, <=, >, >=)
	val s1 = Score(10)
	val s2 = Score(20)
	val s3 = Score(10)
	assert(s1 < s2)
	assert(s1 <= s2)
	assert(s1 <= s3)
	assert(s2 > s1)
	assert(s2 >= s1)
	assert(s1 >= s3)
	assert(!(s2 < s1))
	assert(!(s1 > s2))

	// 5. Unary operator overloading (unaryMinus, unaryPlus, not)
	val sVal = Score(42)
	val neg = -sVal
	assert(neg.value == -42)
	val pos = +sVal
	assert(pos.value == 42)
	val zero = Score(0)
	assert(!zero)
	assert(not zero)
	assert(!(!sVal))

	// 6. Int bitwise methods (shl, shr, ushr, xor, inv)
	val bitA = 8
	assert(bitA.shl(2) == 32)
	assert(bitA.shr(2) == 2)
	val bitB = -8
	assert(bitB.shr(1) == -4)
	assert(bitB.ushr(1) > 0)
	val bitC = 12
	val bitD = 25
	assert(bitC.xor(bitD) == 21)
	assert(bitC.inv() == -13)

	// 7. override keyword
	val worker: BaseWorker = DerivedWorker()
	assert(worker.work() == "DerivedWorker")

	// 8. Duplicate @no_constructor
	assert(DuplicateAnnotationTest.ping() == "pong")

	// 9. fun <T> Kotlin-style generic functions
	assert(testGenericIdentity<Int>(42) == 42)
	assert(testGenericIdentity<String>("hello") == "hello")
	assert(testGenericTransform<Int, String>(10, "ok") == "ok")

	println("Passed ${__FUNC__}")
}

testOperatorOverloading()
