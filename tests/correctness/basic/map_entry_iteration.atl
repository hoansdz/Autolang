fun testMapEntryIteration() {
    // 1. Loop over counts.entries with .key and .value
    val words1 = listOf("apple", "banana", "apple", "cherry", "banana", "apple", "date", "banana", "apple")
    val counts1 = mutableMapOf<String, Int>()

    for (word in words1) {
        val current = counts1[word] ?: 0
        counts1[word] = current + 1
    }

    var maxWord1 = ""
    var maxCount1 = 0

    for (entry in counts1.entries) {
        if (entry.value > maxCount1) {
            maxWord1 = entry.key
            maxCount1 = entry.value
        }
    }

    assert(maxWord1 == "apple")
    assert(maxCount1 == 4)

    // 2. Loop over counts directly with entry properties (e.key, e.value)
    val words2 = listOf("apple", "banana", "apple", "cherry", "banana", "apple", "date", "banana", "apple")
    val counts2 = mutableMapOf<String, Int>()
    for (w in words2) {
        counts2[w] = counts2.getOrDefault(w, 0) + 1
    }
    var maxWord2 = ""
    var maxCount2 = 0
    for (e in counts2) {
        if (e.value > maxCount2) {
            maxCount2 = e.value
            maxWord2 = e.key
        }
    }
    assert(maxWord2 == "apple")
    assert(maxCount2 == 4)

    // 3. Edge cases: empty map entries and single entry
    val emptyM = mapOf<String, Int>()
    assert(emptyM.entries.size == 0)

    val singleM = mapOf("testKey" to 123)
    val entriesArr = singleM.entries
    assert(entriesArr.size == 1)
    val ent = entriesArr[0]
    assert(ent.key == "testKey")
    assert(ent.value == 123)
    assert(ent.component1() == "testKey")
    assert(ent.component2() == 123)
    assert(ent.toString() == "testKey=123")

    // 4. Destructuring in loop over map.entries
    val itemsMap = mapOf("k1" to 10, "k2" to 20)
    var sumEntries = 0
    for ((k, v) in itemsMap.entries) {
        sumEntries += v
    }
    assert(sumEntries == 30)

    println("Passed testMapEntryIteration")
}

testMapEntryIteration()

// 3. Top-level variables without val/var (auto-declare) and loop indexing
scores = listOf(85, 40, 90, 75)
weights = listOf(2, 1, 3, 2)
var totalScore = 0
var totalWeight = 0
for (i in 0 until scores.size) {
    val score = scores[i]
    val weight = weights[i]
    if (score >= 50) {
        totalScore += score * weight
        totalWeight += weight
    }
}
val avg = totalScore / totalWeight
assert(avg == 84)
