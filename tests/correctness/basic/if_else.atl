fun testIfExpression() {
	// Basic if expression as value
	val a = if (true) 10 else 20
	assert(a == 10)

	val b = if (false) 10 else 20
	assert(b == 20)

	val c = <Int>[]
	if (c.size() == 1 && c[1] == 1) {

	}

	// Nested if expression with scoping (inner `a` shadows outer)
	if (true) {
		val a = if (a == 10) {
			20
		} else {
			100
		}
		assert(a == 20)
	}
	assert(a == 10)

	// when used as grade classifier
	val score = 75
	val grade = when (score) {
		score >= 90 -> "A"
		score >= 80 -> "B"
		score >= 70 -> "C"
		score >= 60 -> "D"
		else -> "F"
	}
	assert(grade == "C")

	// Exact value matching with when
	val day = 3
	val dayName = when (day) {
		1 -> "Mon"
		2 -> "Tue"
		3 -> "Wed"
		4 -> "Thu"
		5 -> "Fri"
		else -> "Weekend"
	}
	assert(dayName == "Wed")

	// if statement (no value)
	var counter = 0
	if (true) {
		counter += 1
	}
	if (false) {
		counter += 100
	} else {
		counter += 2
	}
	assert(counter == 3)

	// Nested branching as expression using when
	val x = 5
	val result = when (x) {
		x > 10 -> "big"
		x > 0  -> "small"
		else   -> "negative"
	}
	assert(result == "small")

	// when with range check
	val n = 42
	val category = when (n) {
		n in 0..9   -> "single digit"
		n in 10..99 -> "double digit"
		else        -> "large"
	}
	assert(category == "double digit")

	// If without parentheses tests
	val condFalse = false
	var ifNoParenPassed = false
	if !condFalse {
		ifNoParenPassed = true
	}
	assert(ifNoParenPassed, "if !condFalse without parens failed")

	val val1 = 10
	val val2 = 20
	var logicPassed = false
	if val1 > 0 && val2 == 20 {
		logicPassed = true
	}
	assert(logicPassed, "if with logical and without parens failed")

	var singleLineIf = 0
	if val1 == 10 singleLineIf = 100
	assert(singleLineIf == 100, "single line if without parens failed")

	var elseIfNoParen = 0
	if val1 == 99 {
		elseIfNoParen = 1
	} else if !condFalse {
		elseIfNoParen = 2
	} else {
		elseIfNoParen = 3
	}
	assert(elseIfNoParen == 2, "else if without parens failed")

	println("Passed ${__FUNC__}")
}

testIfExpression()