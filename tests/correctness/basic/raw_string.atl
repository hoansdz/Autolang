fun testRawString() {
	// 1. Simple content, no interpolation
	val s1 = """Hello World"""
	assert(s1 == "Hello World")

	// 2. Backslash is NOT treated as an escape sequence
	val s2 = """Hello\nWorld"""
	assert(s2 == "Hello\\nWorld")

	val s3 = """path\to\file"""
	assert(s3 == "path\\to\\file")

	val s4 = """\t tab \r carriage"""
	assert(s4 == "\\t tab \\r carriage")

	// 3. Quotes inside do not need escaping
	val s5 = """She said "hello" to him"""
	assert(s5 == "She said \"hello\" to him")

	// 4. Interpolation with $value (simple identifier)
	val name = "World"
	val s6 = """Hello $name"""
	assert(s6 == "Hello World")

	val count = 42
	val s7 = """Count is $count items"""
	assert(s7 == "Count is 42 items")

	// 5. Interpolation with ${...} (expression)
	val a = 10
	val b = 20
	val s8 = """Sum is ${a + b}"""
	assert(s8 == "Sum is 30")

	val s9 = """Result: ${a * b - 5}"""
	assert(s9 == "Result: 195")

	// 6. Multiple interpolations in a single raw string
	val x = 3
	val y = 7
	val s10 = """$x plus $y equals ${x + y}"""
	assert(s10 == "3 plus 7 equals 10")

	// 7. Interpolation with string expression inside ${}
	val word = "raw"
	val s11 = """This is a ${word} string"""
	assert(s11 == "This is a raw string")

	// 8. Multiline raw string (spanning multiple lines)
	val multiline = """Line one
Line two
Line three"""
	assert(multiline.contains("Line one"))
	assert(multiline.contains("Line two"))
	assert(multiline.contains("Line three"))
	assert(multiline.contains("\n"))

	// 9. Multiline with interpolation
	val item = "pizza"
	val price = 15
	val receipt = """Item: $item
Price: ${price} USD
Total: ${price * 2} USD"""
	assert(receipt.contains("pizza"))
	assert(receipt.contains("15"))
	assert(receipt.contains("30"))

	// 10. Empty raw string
	val empty = """"""
	assert(empty == "")
	assert(empty.size() == 0)

	// 11. Trailing $ (not followed by valid identifier) - preserve $
	val s12 = """Price: 100$"""
	assert(s12 == "Price: 100$")

	// 12. Trailing backslash (no escape processing)
	val s13 = """windows\path\"""
	assert(s13 == "windows\\path\\")

	// 13. Combined backslash and interpolation
	val dir = "home"
	val s14 = """C:\$dir\file.txt"""
	assert(s14 == "C:\\home\\file.txt")

	// 14. Interpolation with method call inside ${}
	val numStr = "123"
	val s15 = """Value is ${numStr.toInt() + 1}"""
	assert(s15 == "Value is 124")

	println("Passed ${__FUNC__}")
}

testRawString()
