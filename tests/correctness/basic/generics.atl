class GAnimal() {
	fun sound() = "Nothing"
}

class GDog extends GAnimal {
	constructor () {
		super()
	}
	fun sound() = "Go"
}

class GCat extends GAnimal {
	constructor () {
		super()
	}
	fun sound() = "Meow"
}

class GenericTest<T extends GAnimal>() {
	val value: T = T()
	fun sound() = value.sound()
}

class GWrapper<T>() {
	val value: T?
	fun get(): T? = value
}

class GWrapperGenericTest<T, R> extends GWrapper<T> {
	val x: R?
	constructor(x: R?) {
		super()
		this.x = x
	}
	fun getValue(): T? = value
}

class GTestGet<Parent, Child> {
	static var v: Child?
	lateinit val value: Parent
	constructor(value: Child) {
		this.value = value
		if (v == null) {
			this.v = value
		}
	}
	//Not support generic function in class now
}

fun testGenericFunctionWithStatic<T>(value: T): T {
	static var v: T?
	if (v == null) {
		v = value
	}
	return v!
}

fun testGenerics() {
	val f1 = GenericTest<GAnimal>()
	assert(f1 is GenericTest<GAnimal> && f1.value.sound() == f1.sound() && f1.sound() == "Nothing", __FILE__, __LINE__)
	val f2 = GenericTest<GDog>()
	assert(f2 is GenericTest<GDog> && f2.value.sound() == f2.sound() && f2.sound() == "Go", __FILE__, __LINE__)
	val f3 = GenericTest<GCat>()
	assert(f3 is GenericTest<GCat> && f3.value.sound() == f3.sound() && f3.sound() == "Meow", __FILE__, __LINE__)
	val f4 = GWrapperGenericTest<GCat, Int>(null)
	assert(f4.getValue()?.sound() == null, __FILE__, __LINE__)
	val f5 = GWrapperGenericTest<GCat, Float>(null)
	f5.value = GCat()
	assert(f5.getValue()?.sound() == "Meow", __FILE__, __LINE__)
	val f6 = GTestGet<GAnimal, GCat>(GCat())
	assert(f6.value.sound() == "Meow", __FILE__, __LINE__)
	assert(GTestGet<GAnimal, GCat>.v !== GTestGet<GAnimal, GDog>.v, __FILE__, __LINE__)
	assert(testGenericFunctionWithStatic<Int>(5) == 5, __FILE__, __LINE__)
	assert(testGenericFunctionWithStatic<String>("Hello") == "Hello", __FILE__, __LINE__)
	assert(testGenericFunctionWithStatic<Int>(7) == 5, __FILE__, __LINE__)
	println("Passed ${__FUNC__}")
}

testGenerics()