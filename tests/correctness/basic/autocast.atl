class CastGrandParent() {
	fun name() = "GrandParent"
}

class CastParentLevel extends CastGrandParent {
	constructor() {
		super()
	}
	@override
	fun name() = "Parent"
}

class CastChildLevel extends CastParentLevel {
	constructor() {
		super()
	}
	@override
	fun name() = "Child"
}

class CastParent() {
	fun identify() = "Parent"
}

class CastChild extends CastParent {
	constructor() {
		super()
	}
	@override
	fun identify() = "Child"
}

class ShadowTestClass {
	var n = 10
	constructor() {}

	fun getShadowClosure(localN: Int): (Int) -> Int {
		val closure = {|n: Int| // n che field this.n
			this.n + localN + n // 10 + 20 + 30 = 60
		}
		return closure
	}
}

fun acceptFloat(f: Float): Float {
	return f
}

fun returnFloatFromInt(x: Int): Float {
	return x
}

fun acceptParent(p: CastParent): String {
	return p.identify()
}

fun returnParentFromChild(c: CastChild): CastParent {
	return c
}

fun acceptAny(x: Any): String {
	return when (x) {
		is Int -> {
			(x as Int).toString()
		}
		is String -> {
			x as String
		}
		else -> {
			"Unknown"
		}
	}
}

fun acceptAnyCollection(x: Any): String {
	if (x is Array<Int>) {
		return "ArrayInt"
	}
	if (x is Map<String, Int>) {
		return "MapStringInt"
	}
	if (x is Set<Int>) {
		return "SetInt"
	}
	return "Other"
}

fun selectContactNumber(primary: String?, secondary: String?, guardian: String?, branchId: Int?, branchHotline: String?): String {
	var selectedNumber = "1800100099"
	if (primary != null && primary.length >= 10) {
		selectedNumber = primary
	} else {
		if (secondary != null && secondary.length >= 10) {
			selectedNumber = secondary
		} else {
			if (guardian != null && guardian.length >= 10) {
				selectedNumber = guardian
			} else {
				if (branchId != null && branchId > 0) {
					if (branchHotline != null && branchHotline.length >= 10) {
						selectedNumber = branchHotline
					}
				}
			}
		}
	}
	return selectedNumber
}

fun multiGuardCascade(a: String?, b: String?, c: String?, factor: Int?): Int {
	if (a == null || a.length == 0) return 0
	if (b == null || b.length == 0) return a.length
	if (c == null || c.length == 0) return a.length + b.length
	if (factor == null || factor <= 0) return a.length + b.length + c.length
	return (a.length + b.length + c.length) * factor
}

class MockAddress(val street: String?) {
}

class MockCustomer(val id: Int, val address: MockAddress?) {
}

fun resolveCustomerStreet(cust: MockCustomer?): String {
	if (cust != null) {
		val addr = cust.address
		if (addr != null) {
			val st = addr.street
			if (st != null && st.length > 0) {
				return st
			}
		}
	}
	return "UNKNOWN"
}

fun testAlertDispatch(id: Int, phone: String): String {
	return "${id}:${phone}"
}

fun selectContactNumberWithFallback(id: Int, primary: String?, secondary: String?, guardian: String?, branchId: Int?, branchHotline: String?): String {
	var selectedNumber: String? = null

	if (primary != null && primary.length >= 10) {
		selectedNumber = primary
	} else {
		if (secondary != null && secondary.length >= 10) {
			selectedNumber = secondary
		} else {
			if (guardian != null && guardian.length >= 10) {
				selectedNumber = guardian
			} else {
				if (branchId != null && branchId > 0) {
					if (branchHotline != null && branchHotline.length >= 10) {
						selectedNumber = branchHotline
					}
				}
			}
		}
	}

	if (selectedNumber == null) {
		selectedNumber = "1800100099"
	}

	testAlertDispatch(id, selectedNumber)
	return selectedNumber
}

fun testAutoCast() {
	// 1. Auto Cast Int to Float
	val f1: Float = 10
	assert(f1 == 10.0)
	assert(f1.toString().contains("."))

	var f2: Float = 20
	f2 = 30
	assert(f2 == 30.0)
	assert(f2.toString().contains("."))

	// Mix arithmetic
	val mix1 = 3 + 1.5
	val mix2 = 1.5 + 3
	val mix3 = 5 - 2.5
	val mix4 = 2.5 - 1
	val mix5 = 2 * 1.5
	val mix6 = 1.5 * 2
	val mix7 = 5.0 / 2
	
	assert(mix1 == 4.5 && mix1.toString().contains("."))
	assert(mix2 == 4.5 && mix2.toString().contains("."))
	assert(mix3 == 2.5 && mix3.toString().contains("."))
	assert(mix4 == 1.5 && mix4.toString().contains("."))
	assert(mix5 == 3.0 && mix5.toString().contains("."))
	assert(mix6 == 3.0 && mix6.toString().contains("."))
	assert(mix7 == 2.5 && mix7.toString().contains("."))

	// Function parameter and return auto cast
	val paramFloat = acceptFloat(5)
	assert(paramFloat == 5.0 && paramFloat.toString().contains("."))

	val retFloat = returnFloatFromInt(42)
	assert(retFloat == 42.0 && retFloat.toString().contains("."))

	// Collection sugar auto cast
	val arrFloat: Array<Float> = <Float>[1, 2, 3]
	assert(arrFloat.get(0) == 1.0 && arrFloat.get(0).toString().contains("."))
	assert(arrFloat.get(2) == 3.0 && arrFloat.get(2).toString().contains("."))

	val mapFloat: Map<String, Float> = mapOf("one" to 1.0, "two" to 2.0)
	assert(mapFloat.get("one") == 1.0 && mapFloat.get("one")!.toString().contains("."))

	val setFloat: Set<Float> = setOf(10.0, 20.0)
	assert(setFloat.contains(10.0))

	// Nested If and When Cast Tests
	val a = 1
	val testNestedIf = {||
		if (a == 1) {
			if (a == 1) {
				1 // Int auto cast to Float
			} else {
				2.0
			}
		} else {
			3.0
		}
	}
	val resIf = testNestedIf()
	assert(resIf == 1.0 && resIf.toString().contains("."))

	val testNestedWhen = {||
		when (a) {
			1 -> {
				when (a) {
					1 -> 5 // Int auto cast to Float
					else -> 6.0
				}
			}
			else -> 7.0
		}
	}
	val resWhen = testNestedWhen()
	assert(resWhen == 5.0 && resWhen.toString().contains("."))

	// Direct when expression auto cast Int to Float
	val valWhen1: Float = when (a) {
		1 -> {
			15
		}
		else -> {
			20.5
		}
	}
	assert(valWhen1 == 15.0 && valWhen1.toString().contains("."))

	val valWhen2: Float = when (a) {
		1 -> 150
		else -> 200.5
	}
	assert(valWhen2 == 150.0 && valWhen2.toString().contains("."))

	// Check if nested structures without else cause incorrect early returns
	val testNestedNoElse = {||
		if (a == 1) {
			if (a == 1) {
				1
			}
		}
		0
		return 2.0
	}
	val resNoElse = testNestedNoElse()
	assert(resNoElse == 2.0 && resNoElse.toString().contains("."))

	// 2. Auto Cast Child to Parent (Upcast)
	val p1: CastParent = CastChild()
	assert(p1.identify() == "Child")

	val child = CastChild()
	assert(acceptParent(child) == "Child")
	
	val p2 = returnParentFromChild(child)
	assert(p2.identify() == "Child")

	// Parent collection with Child items
	val arrParents: Array<CastParent> = <CastParent>[CastChild()]
	assert(arrParents.get(0).identify() == "Child")

	// 3. Test Any and Type Operators (is, as, as?)
	val valAnyInt: Any = 100
	val valAnyFloat: Any = 200.5
	val valAnyStr: Any = "Hello Any"

	assert(valAnyInt is Int)
	assert(valAnyFloat is Float)
	assert(valAnyStr is String)
	assert(!(valAnyInt is Float))

	// Unsafe cast (as)
	val castInt: Int = valAnyInt as Int
	assert(castInt == 100)
	
	val castFloat: Float = valAnyFloat as Float
	assert(castFloat == 200.5)

	// Safe cast (as?)
	val safeCastInt = valAnyInt as? Int
	assert(safeCastInt != null && safeCastInt! == 100)

	val safeCastFail = valAnyInt as? Float
	assert(safeCastFail == null)

	// Any upcast with function parameter
	assert(acceptAny(42) == "42")
	assert(acceptAny("Hello") == "Hello")
	assert(acceptAny(3.14) == "Unknown")

	// 4. Test Closure Auto Cast (Explicit type and Type inference)
	val castClosure: (Int) -> Float = {|x|
		x
	}
	val resClosure1 = castClosure(5)
	assert(resClosure1 == 5.0 && resClosure1.toString().contains("."))

	val inferClosure = {|x: Int|
		x
	}
	val resClosure2: Float = inferClosure(10)

	// 5. Test Casts inside Closure Body (various types of casts processed inside closures)
	val complexClosure = {|x: Int|
		// Var assignment with auto cast inside closure
		var f: Float = x
		
		// Function argument auto-cast inside closure
		val f2 = acceptFloat(x)
		
		// Safe cast (as?) inside closure
		val valAny: Any = x
		val safeCast = valAny as? Int
		
		// Nested if/when casting inside closure
		val nestedVal: Float = if (x == 5) {
			10 // Int auto cast to Float
		} else {
			20.5
		}
		
		f + f2 + safeCast! + nestedVal
	}
	val resComplex = complexClosure(5) // 5.0 + 5.0 + 5 + 10.0 = 25.0
	assert(resComplex == 25.0 && resComplex.toString().contains("."))

	// 6. Test Nullable Inference with If and When
	var nullableIf = if (a == 1) 10 else null
	assert(nullableIf == 10)
	nullableIf = null
	assert(nullableIf == null)

	var nullableWhen = when (a) {
		1 -> {
			20.5
		}
		else -> {
			null
		}
	}
	assert(nullableWhen == 20.5)
	nullableWhen = null
	assert(nullableWhen == null)

	// 7. Multi-level Inheritance & Cast Tests
	val gp: CastGrandParent = CastChildLevel()
	assert(gp.name() == "Child")
	assert(gp is CastChildLevel)
	assert(gp is CastParentLevel)
	assert(gp is CastGrandParent)

	val castParent = gp as CastParentLevel
	assert(castParent.name() == "Child")

	val safeCastChild = gp as? CastChildLevel
	assert(safeCastChild != null && safeCastChild!.name() == "Child")

	val safeCastParentFail = CastParentLevel() as? CastChildLevel
	assert(safeCastParentFail == null)

	// 8. Shadowing in Closures Tests
	val shadowClass = ShadowTestClass()
	val shadowClosure = shadowClass.getShadowClosure(20)
	assert(shadowClosure(30) == 60)

	// 9. Collection Autocast & Type Operations (Array, Set, Map with Any, is, as, as?)
	val rawArr = [1, 2, 3]
	val anyArr: Any = rawArr
	assert(anyArr is Array<Int>)
	val castArr = anyArr as Array<Int>
	assert(castArr.size() == 3 && castArr[0] == 1)
	val safeArr = anyArr as? Array<Int>
	assert(safeArr != null && safeArr![1] == 2)
	val safeArrFail = anyArr as? Map<String, Int>
	assert(safeArrFail == null)

	val rawMap = mapOf("a" to 1, "b" to 2)
	val anyMap: Any = rawMap
	assert(anyMap is Map<String, Int>)
	val castMap = anyMap as Map<String, Int>
	assert(castMap.size() == 2 && castMap["a"] == 1)
	val safeMap = anyMap as? Map<String, Int>
	assert(safeMap != null && safeMap!["b"] == 2)
	val safeMapFail = anyMap as? Set<Int>
	assert(safeMapFail == null)

	val rawSet = setOf(10, 20, 30)
	val anySet: Any = rawSet
	assert(anySet is Set<Int>)
	val castSet = anySet as Set<Int>
	assert(castSet.size() == 3 && castSet.contains(10))
	val safeSet = anySet as? Set<Int>
	assert(safeSet != null && safeSet!.contains(20))
	val safeSetFail = anySet as? Array<Int>
	assert(safeSetFail == null)

	assert(acceptAnyCollection(rawArr) == "ArrayInt")
	assert(acceptAnyCollection(rawMap) == "MapStringInt")
	assert(acceptAnyCollection(rawSet) == "SetInt")
	assert(acceptAnyCollection("other text") == "Other")

	val childArr = [CastChild()]
	val anyChildArr: Any = childArr
	assert(anyChildArr is Array<CastChild>)
	val castChildArr = anyChildArr as Array<CastChild>
	assert(castChildArr[0].identify() == "Child")

	// 10. Mixed Type Element Autocast in Collection
	val mixedArr = [1, 1.5]
	assert(mixedArr.size() == 2)
	assert(mixedArr[0] == 1.0)
	assert(mixedArr[1] == 1.5)
	var arrIntCount = 0
	var arrFloatCount = 0
	for (x in mixedArr) {
		if (x is Int) {
			arrIntCount += 1
		}
		if (x is Float) {
			arrFloatCount += 1
		}
	}
	assert(arrIntCount == 0)
	assert(arrFloatCount == 2)

	// 11. Bool to Int/Float conversion in Array
	val boolArrInferred1 = [true, 10]
	assert(boolArrInferred1[0] == 1)
	assert(boolArrInferred1[1] == 10)

	val boolArrInferred2 = [10, true]
	assert(boolArrInferred2[0] == 10)
	assert(boolArrInferred2[1] == 1)

	val boolArrInferred3 = [true, 2.5]
	assert(boolArrInferred3[0] == 1.0)
	assert(boolArrInferred3[1] == 2.5)

	// 12. If and While condition auto conversion for Int and Float
	var ifIntConst1 = 0
	if (1) { ifIntConst1 = 10 } else { ifIntConst1 = 20 }
	assert(ifIntConst1 == 10)

	var ifIntConst2 = 0
	if (0) { ifIntConst2 = 10 } else { ifIntConst2 = 20 }
	assert(ifIntConst2 == 20)

	var ifFloatConst1 = 0
	if (3.14) { ifFloatConst1 = 10 } else { ifFloatConst1 = 20 }
	assert(ifFloatConst1 == 10)

	var ifFloatConst2 = 0
	if (0.0) { ifFloatConst2 = 10 } else { ifFloatConst2 = 20 }
	assert(ifFloatConst2 == 20)

	val intNonZeroVar = 42
	var ifIntVarCheck1 = false
	if (intNonZeroVar) { ifIntVarCheck1 = true }
	assert(ifIntVarCheck1 == true)

	val intZeroVar = 0
	var ifIntVarCheck2 = false
	if (intZeroVar) { ifIntVarCheck2 = true } else { ifIntVarCheck2 = false }
	assert(ifIntVarCheck2 == false)

	val floatNonZeroVar = 0.5
	var ifFloatVarCheck1 = false
	if (floatNonZeroVar) { ifFloatVarCheck1 = true }
	assert(ifFloatVarCheck1 == true)

	val floatZeroVar = 0.0
	var ifFloatVarCheck2 = false
	if (floatZeroVar) { ifFloatVarCheck2 = true } else { ifFloatVarCheck2 = false }
	assert(ifFloatVarCheck2 == false)

	val ifExprRes1 = if (intNonZeroVar) 100 else 200
	assert(ifExprRes1 == 100)

	val ifExprRes2 = if (floatZeroVar) 100 else 200
	assert(ifExprRes2 == 200)

	var whileIntCount = 3
	var whileIntSum = 0
	while (whileIntCount) {
		whileIntSum += whileIntCount
		whileIntCount -= 1
	}
	assert(whileIntSum == 6)
	assert(whileIntCount == 0)

	var whileFloatCount = 2.0
	var whileFloatSteps = 0
	while (whileFloatCount) {
		whileFloatSteps += 1
		whileFloatCount -= 1.0
	}
	assert(whileFloatSteps == 2)
	assert(whileFloatCount == 0.0)

	// 13. Smart Cast / Flow-sensitive typing (Kotlin style)
	val primaryPhone: String? = "0123456789"
	var selectedNum = ""
	if (primaryPhone != null && primaryPhone.length >= 10) {
		selectedNum = primaryPhone
	}
	assert(selectedNum == "0123456789")

	// OR short-circuit smart cast
	val optStr: String? = null
	var orCheck = false
	if (optStr == null || optStr.length < 5) {
		orCheck = true
	}
	assert(orCheck == true)

	// Chained AND smart cast
	val chainA: String? = "hello"
	val chainB: String? = "world"
	var chainSum = 0
	if (chainA != null && chainB != null && chainA.length + chainB.length == 10) {
		chainSum = chainA.length + chainB.length
	}
	assert(chainSum == 10)

	// Early return guard smart cast
	val guardTest: (String?) -> Int = {|x|
		if (x == null) return 0
		return x.length
	}
	assert(guardTest(null) == 0)
	assert(guardTest("abcdef") == 6)

	// While loop smart cast
	var loopItem: String? = "test"
	var loopCount = 0
	while (loopItem != null) {
		loopCount += loopItem.length
		loopItem = null
	}
	assert(loopCount == 4)

	// 14. Deeply nested complex if-else cascade with multiple nullable sources
	assert(selectContactNumber("0912345678", null, null, null, null) == "0912345678")
	assert(selectContactNumber(null, "0987654321", null, null, null) == "0987654321")
	assert(selectContactNumber("short", null, "0900112233", null, null) == "0900112233")
	assert(selectContactNumber(null, null, null, 105, "0243999888") == "0243999888")
	assert(selectContactNumber(null, null, null, 0, "0243999888") == "1800100099")
	assert(selectContactNumber(null, null, null, null, null) == "1800100099")

	// 15. Multi-level early return guard cascade
	assert(multiGuardCascade(null, "b", "c", 2) == 0)
	assert(multiGuardCascade("hello", null, "c", 2) == 5)
	assert(multiGuardCascade("hello", "world", null, 2) == 10)
	assert(multiGuardCascade("hello", "world", "abc", null) == 13)
	assert(multiGuardCascade("hello", "world", "abc", 3) == 39)

	// 16. Nested while loops with smart cast and reassignments
	var outerItem: String? = "outer"
	var totalChars = 0
	while (outerItem != null) {
		var innerItem: String? = "inner"
		while (innerItem != null) {
			totalChars += outerItem.length + innerItem.length
			innerItem = null
		}
		outerItem = null
	}
	assert(totalChars == 10)

	// 17. Deep nested short-circuit conditions with chained accesses
	val strX: String? = "alphanumeric"
	val strY: String? = "numeric"
	var deepLogicResult = false
	if ((strX != null && strX.length > 5 && (strY != null && strY.length > 3 && strX.length + strY.length == 19))) {
		deepLogicResult = true
	}
	assert(deepLogicResult == true)

	// 18. Multi-variable nested if blocks with cumulative non-null narrowing
	val prefix: String? = "user"
	val mid: String? = "_"
	val suffix: String? = "105"
	var combinedText = ""
	if (prefix != null) {
		if (mid != null) {
			if (suffix != null) {
				combinedText = prefix + mid + suffix
				assert(prefix.length == 4)
				assert(mid.length == 1)
				assert(suffix.length == 3)
			}
		}
	}
	assert(combinedText == "user_105")

	// 19. Nested complex boolean expressions with alternating AND / OR combinations and parentheses
	val c1: String? = "abc"
	val c2: String? = null
	val c3: String? = "defgh"
	val matchResult = ((c1 != null && c1.length == 3) || (c2 != null && c2.length > 0)) && (c3 != null && c3.length == 5)
	assert(matchResult)

	// 20. Nested if expressions as values with smart casts
	val aVal: String? = "Alpha"
	val bVal: String? = "Beta"
	val cVal: String? = null
	val nestedIfVal: String = if (aVal != null) {
		if (bVal != null) {
			aVal + ":" + bVal
		} else {
			aVal
		}
	} else {
		if (cVal != null) {
			cVal
		} else {
			"None"
		}
	}
	assert(nestedIfVal == "Alpha:Beta")

	// 21. Nested when expressions with smart-casted variables
	val tag: String? = "OK"
	val code: Int? = 200
	val whenSummary = when {
		tag != null && tag.length > 0 -> when {
			code != null && code >= 200 -> tag + "_" + code.toString()
			else -> tag + "_error"
		}
		else -> "invalid"
	}
	assert(whenSummary == "OK_200")

	// 22. Nested closures capturing nullable variables that undergo smart casts
	val optOuter: String? = "closure_outer"
	if (optOuter != null) {
		val fn = {|extra: String?|
			if (extra != null) {
				optOuter.length + extra.length
			} else {
				optOuter.length
			}
		}
		assert(fn("test") == 17)
		assert(fn(null) == 13)
	}

	// 23. Nested loop with conditional break/continue and smart casting
	val items: Array<String?> = <String?>["first", null, "second", "very_long_string", "third"]
	var validChars = 0
	for (item in items) {
		if (item == null) {
			continue
		}
		if (item.length > 10) {
			break
		}
		validChars += item.length
	}
	assert(validChars == 11)

	// 24. Deep hierarchical data navigation with multiple nested levels
	val cust1 = MockCustomer(1, MockAddress("123 Main St"))
	val cust2 = MockCustomer(2, MockAddress(null))
	val cust3 = MockCustomer(3, null)
	val cust4: MockCustomer? = null
	assert(resolveCustomerStreet(cust1) == "123 Main St")
	assert(resolveCustomerStreet(cust2) == "UNKNOWN")
	assert(resolveCustomerStreet(cust3) == "UNKNOWN")
	assert(resolveCustomerStreet(cust4) == "UNKNOWN")

	// 25. Control flow analysis with null-check fallback assignment
	val resFallback1 = selectContactNumberWithFallback(105, "0912345678", null, null, null, null)
	assert(resFallback1 == "0912345678")
	val resFallback2 = selectContactNumberWithFallback(105, null, null, null, null, null)
	assert(resFallback2 == "1800100099")
	assert(testAlertDispatch(105, resFallback2) == "105:1800100099")

	// Direct if (x == null) { x = non_null } smart cast in block
	var testVar: String? = null
	if (testVar == null) {
		testVar = "resolved_fallback"
	}
	assert(testVar.length == 17)
	assert(testAlertDispatch(1, testVar) == "1:resolved_fallback")

	// if-else branch merge where both branches assign non-null
	var branchVar: String? = null
	if (1 == 1) {
		branchVar = "branch_a"
	} else {
		branchVar = "branch_b"
	}
	assert(branchVar.length == 8)
	assert(testAlertDispatch(2, branchVar) == "2:branch_a")

	// 26. Sequential multiple fallback checks on independent variables
	var seqA: String? = null
	var seqB: String? = null
	if (seqA == null) { seqA = "primary" }
	if (seqB == null) { seqB = "secondary" }
	assert(seqA.length == 7)
	assert(seqB.length == 9)
	assert(seqA + "_" + seqB == "primary_secondary")

	// 27. Nested null-fallback inside another conditional block
	val hasPermission = true
	var permNumber: String? = null
	if (hasPermission) {
		if (permNumber == null) {
			permNumber = "0909998877"
		}
		assert(permNumber.length == 10)
		assert(testAlertDispatch(99, permNumber) == "99:0909998877")
	}

	// 28. Fallback assigned from a non-null function return
	var funcAssigned: String? = null
	if (funcAssigned == null) {
		funcAssigned = testAlertDispatch(1, "resolved")
	}
	assert(funcAssigned.length == 10)
	assert(funcAssigned == "1:resolved")

	// 29. Local variable declaration inside closure at file/top-level scope
	val closureWithLocalVal = {||
		val primary = "1234567890"
		if (primary.length >= 10) primary else "fallback"
	}
	assert(closureWithLocalVal() == "1234567890")

	println("Passed ${__FUNC__}")
}

testAutoCast()
