class Animal() {
	fun sound(): String {
		return "None"
	} 
}

class Dog extends Animal {
	constructor () {
		super()
	}
	@override
	fun sound(): String {
		return "Go"
	}
}

class Cat extends Animal {
	constructor () {
		super()
	}
	@override
	fun sound(): String {
		return "Meow"
	}
}

fun testOverride() {
	val cat: Animal = Cat()
	val dog: Animal = Dog()
	assert(cat.sound() == "Meow")
	assert(dog.sound() == "Go")
	println("Passed ${__FUNC__}")
}

testOverride()