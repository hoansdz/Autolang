// Test 3: Generic function with if accessing array element
fun <T> firstOr(a: Array<T>, d: T): T {
    if (a.size > 0) {
        return a[0]
    }
    return d
}

val arrNums = [10, 20, 30]
val firstNum = firstOr(arrNums, -1)
if (firstNum != 10) {
    throw Exception("Test 3 failed: expected 10, got " + firstNum)
}

val emptyNums: Array<Int> = []
val defaultNum = firstOr(emptyNums, 99)
if (defaultNum != 99) {
    throw Exception("Test 3 fallback failed: expected 99, got " + defaultNum)
}

// Test 4: var counter in loop of generic function
fun <T> countMatches(arr: Array<T>, target: T): Int {
    var count = 0
    for (x in arr) {
        if (x == target) {
            count += 1
        }
    }
    return count
}

val sampleArr = [1, 2, 1, 3, 1]
val c1 = countMatches(sampleArr, 1)
if (c1 != 3) {
    throw Exception("Test 4 failed: expected 3, got " + c1)
}

// Test 5: Extension on specialized generic class Array<Int>
fun Array<Int>.totalSum(): Int {
    var sum = 0
    for (x in this) {
        sum += x
    }
    return sum
}

val sumArr = [1, 2, 3, 4]
val total = sumArr.totalSum()
if (total != 10) {
    throw Exception("Test 5 failed: expected 10, got " + total)
}

// Test 6: Unit as function return type
fun verifyUnitReturn(): Unit {
    var a = 1
    a += 2
}
verifyUnitReturn()

println("Passed testFixesRegression")
