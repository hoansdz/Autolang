enum State {
	INITIAL, RUNNING, LOADED;
	fun getName(): String = when (this) {
		INITIAL -> "INITIAL"
		RUNNING -> "RUNNING"
		LOADED -> "LOADED"
		else -> "NOTHING"
	}
}

fun testEnum() {
	val a = State.RUNNING

	assert(State.INITIAL != State.RUNNING)
	assert(State.RUNNING == State.RUNNING)
	assert(State.LOADED != State.RUNNING)
	assert(a == State.RUNNING)
	assert(a != State.LOADED)
	assert(State.INITIAL.getName() == "INITIAL")
	assert(State.LOADED.getName() == "LOADED")
	assert(State.RUNNING.getName() == "RUNNING")
	assert(a.getName() == "RUNNING")

	println("Passed ${__FUNC__}")
}

testEnum()