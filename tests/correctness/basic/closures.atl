fun makeAdder(x: Int): (Int) -> Int {
    return {|y| x + y}
}

fun abc(a: Int, b: Int, c: (Int, Int) -> Int): Int = c(a, b)

class TestParentClosureClass {
	fun test() {
		assert(false)
	}

	fun getTestFunction() = test // return test
}

class TestClosureClass extends TestParentClosureClass {
    var n = 5
    
    val memClosure = {|x: Int| 
        this.n + x 
    }

	constructor () {
		super()
	}

	@override
	fun test() {
		assert(true)
	}

    fun createMethodClosure(base: Int): (Int) -> Int {
        val factor1: Float = 1
		static val factor2: Int = 1
		val factor3: Bool = false
        return {|y|
			Int(n * (factor1 + factor2) + factor3) + base + y 
		}
    }
}

fun testFunctionClosures() {
    val factor = 10
    val explicitAdd = {|x: Int| -> { x + factor }}
    assert(explicitAdd(5) == 15)

	assert(abc(1,2) {|a, b| a + b} == 3)

    val a = 100
    val outer: (Int) -> ((Int) -> Int) = {|b| {|c| a + b + c}}
    val inner = outer(50)
    assert(inner(10) == 160)

    var x = 500
    val snapshot = {|| x}
    x = 999
    assert(snapshot() == 500)

    val addFive = makeAdder(5)
    assert(addFive(2) == 7)

	val nested: () -> ((Float) -> String) -> ((Float) -> String) = {||
		return {|value|
			return {|value|
				"Hello"
			}
		}
	}

    var total = 0
    for (i in 0..10000) {
        val adder = {|v: Int| v + i}
        val res = adder(1)
        total += res
    }
    assert(total == 50015001)

    println("Passed ${__FUNC__}")
}

fun testClassClosures() {
    val clazz = TestClosureClass()
    clazz.n = 7
	val testFunc = clazz.getTestFunction()
	testFunc()
    
    assert(clazz.memClosure(3) == 10)
    
    val methodClosure = clazz.createMethodClosure(10)
    assert(methodClosure(5) == 29)
    
    println("Passed ${__FUNC__}")
}

fun testDeepNestedPipelineClosures() {
    // 1. 4-level nested currying
    val curry4 = {|a: Int|
        {|b: Int|
            {|c: Int|
                {|d: Int|
                    a * 1000 + b * 100 + c * 10 + d
                }
            }
        }
    }
    val step1 = curry4(4)
    val step2 = step1(3)
    val step3 = step2(2)
    val result4 = step3(1)
    assert(result4 == 4321)
    assert(curry4(9)(8)(7)(6) == 9876)

    // 2. Closure pipeline in an array
    val ops: Array<(Int) -> Int> = [
        {|x: Int| x + 10},
        {|x: Int| x * 3},
        {|x: Int| x - 5},
        {|x: Int| x / 2}
    ]
    var value = 5
    for (op in ops) {
        value = op(value)
    }
    // ((5 + 10) * 3 - 5) / 2 = (45 - 5) / 2 = 20
    assert(value == 20)

    // 3. Closure capturing object reference and mutating deeply
    val person = TestClosureClass()
    person.n = 100
    val mutator = {|bonus: Int|
        person.n = person.n + bonus
    }
    mutator(50)
    assert(person.n == 150)
    mutator(25)
    assert(person.n == 175)

    println("Passed ${__FUNC__}")
}

fun helperRunClosure(a: Int, b: Int, c: (Int, Int) -> Int): Int = c(a, b)
fun helperRunBlock(fn: () -> Int): Int = fn()

fun testKotlinStyleClosures() {
    // Explicit parameter types
    val add1 = { x: Int, y: Int -> x + y }
    assert(add1(3, 4) == 7)

    // Inferred parameter types
    val add2: (Int, Int) -> Int = { x, y -> x + y }
    assert(add2(10, 20) == 30)

    val doubleVal: (Int) -> Int = { x -> x * 2 }
    assert(doubleVal(5) == 10)

    // 0 parameters
    val get42 = { -> 42 }
    assert(get42() == 42)

    // Trailing closure syntax
    val res1 = helperRunClosure(5, 6) { a, b -> a * b }
    assert(res1 == 30)

    // Nested arrow closures
    val outer = { a: Int -> { b: Int -> a + b } }
    assert(outer(10)(20) == 30)

    // Multi-line closure
    val multi = { x: Int, y: Int ->
        val temp = x * 2
        temp + y
    }
    assert(multi(3, 4) == 10)

    // Higher-order function as closure parameter
    val applyFn = { x: Int, op: (Int) -> Int -> op(x) }
    assert(applyFn(5) { it: Int -> it + 3 } == 8)

    // 0-param block without arrow
    val r0 = helperRunBlock { 100 }
    assert(r0 == 100)

    println("Passed ${__FUNC__}")
}

testFunctionClosures()
testClassClosures()
testDeepNestedPipelineClosures()
testKotlinStyleClosures()