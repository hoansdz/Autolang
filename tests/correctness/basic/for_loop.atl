fun testForLoop() {
	// Basic range loop: 1..10 inclusive
	var a = 0
	val b = 10
	val c = 0
	for (i in 1..(b - c)) {
		a += i
	}
	assert(a == 55)  // sum 1..10

	// Exclusive range: 0..<10 (0 to 9)
	var sumExclusive = 0
	for (i in 0..<10) {
		sumExclusive += i
	}
	assert(sumExclusive == 45)  // sum 0..9

	// Single-element range
	var singleSum = 0
	for (i in 3..3) {
		singleSum += i
	}
	assert(singleSum == 3)

	// Loop variable scoping: capture last value
	var lastI = -1
	for (i in 0..4) {
		lastI = i
	}
	assert(lastI == 4)

	// Nested for loops: count iterations = 3*3 = 9
	var product = 0
	for (i in 1..3) {
		for (j in 1..3) {
			product += i * j
		}
	}
	assert(product == 36)

	// Loop over array
	val items = <Int>[10, 20, 30, 40, 50]
	var sumItems = 0
	for (item in items) {
		sumItems += item
	}
	assert(sumItems == 150)

	// Loop over string
	val expr = "{[()]}"
	var collected = ""
	for (ch in expr) {
		collected += ch
	}
	assert(collected == "{[()]}")

	// Empty string loop
	var emptyCount = 0
	for (ch in "") {
		emptyCount += 1
	}
	assert(emptyCount == 0)

	// Bracket validation test using string loop
	val stack = <String>[]
	var isValid = true
	for (ch in expr) {
		if (ch == "(" || ch == "[" || ch == "{") {
			stack.add(ch)
		} else if (ch == ")" || ch == "]" || ch == "}") {
			if (stack.isEmpty()) {
				isValid = false
				break
			}
			val top = stack.removeAt(stack.size - 1)
			if ((ch == ")" && top != "(") ||
				(ch == "]" && top != "[") ||
				(ch == "}" && top != "{")) {
				isValid = false
				break
			}
		}
	}
	assert(isValid && stack.isEmpty())

	// Edge case: until keyword in for loop
	var untilSum = 0
	for (i in 0 until 5) {
		untilSum += i
	}
	assert(untilSum == 10) // 0 + 1 + 2 + 3 + 4

	// Edge case: inverted range 5..1 does not execute
	var invertedCount = 0
	for (i in 5..1) {
		invertedCount += 1
	}
	assert(invertedCount == 0)

	// Edge case: empty array loop does not execute
	var emptyArrLoopCount = 0
	for (item in <Int>[]) {
		emptyArrLoopCount += 1
	}
	assert(emptyArrLoopCount == 0)

	// Edge case: empty set loop does not execute
	var emptySetLoopCount = 0
	val emptySetObj = Set<Int>()
	for (elem in emptySetObj) {
		emptySetLoopCount += 1
	}
	assert(emptySetLoopCount == 0)

	println("Passed ${__FUNC__}")
}

testForLoop()