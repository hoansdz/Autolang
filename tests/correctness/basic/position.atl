class TestPositionMember(val a: Int, val b: Int) {
	val c: Int = 3
	fun test() {
		assert(a != b && a != c && b != c)
	}
}

fun testPositionFunc(a: Int, b: Int) {
	assert(a != b)
}

fun testPosition() {
	testPositionFunc(1, 2)
	TestPositionMember(1, 2).test()
	val value = 67
	val first = {|x: Int| -> {
		assert(x != value)
	}}
	first(0)
	val second = {|x: Int, y: Int| -> {
		assert(x != y)
		assert(x == value)
	}}
	second(67, 0)
	println("Passed ${__FUNC__}")
}

testPosition()