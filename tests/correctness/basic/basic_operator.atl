fun testBasicOperator() {
	// Arithmetic
	val a = 1 + 2
	assert(a == 3)

	val b = 5 - (2 + 3)
	assert(b == 0)

	val c = 5 * (5 - 2 * 2)
	assert(c == 5)

	val d = 5 / (5 - 2 * 2)
	assert(d == 5)

	val e = 10 / 2 * 3
	assert(e == 15)

	// Modulo
	assert(10 % 3 == 1)
	assert(7 % 7 == 0)
	assert(1 % 5 == 1)

	// Unary minus
	val neg = -5
	assert(neg == -5)
	assert(-neg == 5)

	// Compound assignment
	var x = 10
	x += 5
	assert(x == 15)
	x -= 3
	assert(x == 12)
	x *= 2
	assert(x == 24)
	x /= 4
	assert(x == 6)

	// Float arithmetic
	val f1 = 1.5 + 0.5
	assert(f1 == 2.0)
	val f2 = 3.0 * 0.5
	assert(f2 == 1.5)
	val f3 = 7.0 / 2.0
	assert(f3 == 3.5)

	// Int/Float mixing
	val mixed = 3 + 1.5
	assert(mixed == 4.5)

	// String concatenation
	val s = "Hello" + " " + "World"
	assert(s == "Hello World")

	// Comparison operators
	assert(3 > 2)
	assert(2 < 3)
	assert(3 >= 3)
	assert(3 <= 3)
	assert(3 == 3)
	assert(3 != 4)

	println("Passed ${__FUNC__}")
}

testBasicOperator()