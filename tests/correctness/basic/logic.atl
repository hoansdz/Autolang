class TestLogicClass {
	val a = true

	fun test() {
		assert((!a) == false)
		assert(-(!a) == 0)
	}
}

fun testLogic() {
	// Basic boolean values
	assert(true == true)
	assert(false == false)
	assert(true != false)

	// AND (&&)
	assert((true && true) == true)
	assert((true && false) == false)
	assert((false && true) == false)
	assert((false && false) == false)

	// OR (||)
	assert((true || true) == true)
	assert((true || false) == true)
	assert((false || true) == true)
	assert((false || false) == false)

	// NOT (!)
	assert(!true == false)
	assert(!false == true)
	assert(!!true == true)

	// Combined expressions
	val a = true && false
	assert((!a) == true)

	val b = true || false
	assert(b == true && -b == -(1))

	val c = !false
	assert(c == true)

	// Short-circuit: && stops at first false (right side not evaluated)
	var evaluated = false
	val sideEffect = {||
		evaluated = true
		false
	}
	val r1 = false && sideEffect()
	assert(!evaluated)

	// Short-circuit: || stops at first true (right side not evaluated)
	evaluated = false
	val sideEffect2 = {||
		evaluated = true
		true
	}
	val r2 = true || sideEffect2()
	assert(!evaluated)

	// De Morgan's laws
	val p = true
	val q = false
	assert(!(p && q) == (!p || !q))
	assert(!(p || q) == (!p && !q))

	// Class method with negation
	val testLogicObj = TestLogicClass()
	testLogicObj.test()

	println("Passed ${__FUNC__}")
}

testLogic()