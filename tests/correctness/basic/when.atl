fun testWhen() {
	val a = 5
	when (a) {
		in 1..9 -> {}
		else -> assert(false)
	}

	val b = 6
	when (b) {
		b != 6 -> assert(false)
	}

	when (b) {
		is Int -> {}
		else -> assert(false)
	}
	val events = ["CREATE", "PAY", "PACK", "VERIFY", "SHIP"]
	var state = "START"
	var successCount = 0
	for (event in events) {
		when (state) {
			"START" -> {
				if (event == "CREATE") {
					state = "CREATED"
					successCount++
				} else {
					state = "REJECTED"
					break
				}
			}
			"CREATED" -> {
				if (event == "PAY") {
					state = "PAID"
					successCount++
				} else {
					state = "REJECTED"
					break
				}
			}
			"PAID" -> {
				if (event == "VERIFY") {
					state = "VERIFIED"
					successCount++
				} else {
					state = "REJECTED"
					break
				}
			}
			"VERIFIED" -> {
				if (event == "PACK") {
					state = "PACKED"
					successCount++
				} else {
					state = "REJECTED"
					break
				}
			}
			else -> {
				state = "REJECTED"
				break
			}
		}
	}
	assert(state == "REJECTED" && successCount == 2, "State machine transition failed")

	// 1. When as expression returning a value
	val num = 2
	val strNum = when (num) {
		1 -> "one"
		2 -> "two"
		else -> "other"
	}
	assert(strNum == "two")

	// 2. When without subject (evaluating boolean conditions)
	val score = 85
	val grade = when {
		score >= 90 -> "A"
		score >= 80 -> "B"
		else -> "C"
	}
	assert(grade == "B")

	// 3. When with !in range
	val valX = 15
	val rangeCheck = when (valX) {
		!in 1..10 -> "outside"
		else -> "inside"
	}
	assert(rangeCheck == "outside")

	// 4. When with !is type check
	val valY: Any = 123
	val typeCheck = when (valY) {
		!is String -> "not string"
		else -> "is string"
	}
	assert(typeCheck == "not string")

	// 5. When subject without parentheses
	val targetVal = 2
	val matched = when targetVal {
		1 -> "one"
		2 -> "two"
		else -> "other"
	}
	assert(matched == "two", "when targetVal without parens failed")

	var sideEffect = 0
	when targetVal + 1 {
		3 -> sideEffect = 30
		else -> sideEffect = -1
	}
	assert(sideEffect == 30, "when expr without parens failed")

	// 6. When subject with Any type and range check
	val inputData: Any = 42
	val classification = when (inputData) {
		in 1..10   -> "Single-digit range"
		!in 0..100 -> "Out-of-bounds number"
		is Int     -> "Valid integer value"
		!is String -> "Non-string object"
		else       -> "Other"
	}
	assert(classification == "Valid integer value", "when Any range/is matching failed")

	val fiveAny: Any = 5
	val rangeFive = when fiveAny {
		in 1..10 -> "in_range"
		else     -> "out_range"
	}
	assert(rangeFive == "in_range", "when Any in 1..10 failed")

	val outAny: Any = 200
	val rangeOut = when outAny {
		!in 0..100 -> "out_range"
		else       -> "in_range"
	}
	assert(rangeOut == "out_range", "when Any !in 0..100 failed")

	// 7. toBinaryString testing
	assert(42.toBinaryString() == "101010", "42.toBinaryString() failed")
	assert(Int.toBinaryString(42) == "101010", "Int.toBinaryString(42) failed")
	assert(toBinaryString(42) == "101010", "toBinaryString(42) failed")
	assert(0.toBinaryString() == "0", "0.toBinaryString() failed")
	assert(7.toBinaryString() == "111", "7.toBinaryString() failed")

	println("Passed ${__FUNC__}")
}

testWhen()