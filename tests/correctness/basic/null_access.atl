class NullAccessTest(var value: Int) {
	fun plus(value: Int) {
		this.value += value
	}
}

fun testNullAccess() {
	var value: NullAccessTest? = null
	value?.plus(5)
	value = NullAccessTest(5)
	value?.plus(5)
	assert(value!.value == 10)

	var f1 = (value?.value ?? 2)
	assert(f1 == 10)

	var secondaryValue: NullAccessTest? = null
	assert((secondaryValue?.value ?? 2) == 2)
	secondaryValue = NullAccessTest(3)
	assert((secondaryValue?.value ?? 2) == 3)
	assert(secondaryValue!.value == 3)

	value = null
	val f2 = (null ?? 2)
	assert(f2 == 2)

	// Chained Elvis
	val n1: Int? = null
	val n2: Int? = null
	val n3: Int? = 55
	val chained1 = n1 ?: n2 ?: n3 ?: 99
	assert(chained1 == 55)

	val chained2 = n1 ?: n2 ?: 100
	assert(chained2 == 100)

	println("Passed ${__FUNC__}")
}

testNullAccess()