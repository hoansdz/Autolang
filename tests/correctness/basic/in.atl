fun testInExpression() {
	val a = 1
	val b = 2

	// Int range inclusive
	assert((a + b) in 3..9, __FILE__, __LINE__)
	assert(!((a - b) in 3..9), __FILE__, __LINE__)
	assert((a + b) in 0..3, __FILE__, __LINE__)

	// Int range exclusive
	assert(!((a + b) in 0..<3), __FILE__, __LINE__)
	assert((a + b) in 0..<4, __FILE__, __LINE__)

	// Boundary conditions
	assert(3 in 3..9, __FILE__, __LINE__)    // inclusive lower bound
	assert(9 in 3..9, __FILE__, __LINE__)    // inclusive upper bound
	assert(!(2 in 3..9), __FILE__, __LINE__) // below lower bound
	assert(!(10 in 3..9), __FILE__, __LINE__)// above upper bound
	assert(!(3 in 4..9), __FILE__, __LINE__) // just below lower

	// Exclusive upper bound
	assert(!(9 in 3..<9), __FILE__, __LINE__) // exclusive upper
	assert(8 in 3..<9, __FILE__, __LINE__)

	// in with Array<Int>
	val list = <Int>[1, 2, 3, 4, 5]
	assert(1 in list, __FILE__, __LINE__)
	assert(5 in list, __FILE__, __LINE__)
	assert(!(6 in list), __FILE__, __LINE__)
	assert(!(0 in list), __FILE__, __LINE__)

	// in with Set<String>
	val set = <String> {
		"Hello everyone",
		"My name is John",
		"My name is John",  // duplicates collapsed
	}
	assert("My name is John" in set, __FILE__, __LINE__)
	assert("Hello everyone" in set, __FILE__, __LINE__)
	assert(!("f" in set), __FILE__, __LINE__)
	assert(!("" in set), __FILE__, __LINE__)

	// in with Array<String>
	val words = <String>["apple", "banana", "cherry"]
	assert("banana" in words, __FILE__, __LINE__)
	assert(!("grape" in words), __FILE__, __LINE__)

	println("Passed ${__FUNC__}")
}

testInExpression()