fun testDestructureLambdaAndMap() {
    // 1. Destructuring in lambda single level
    val items = mapOf(
        "PHONE" to (600 to 0.10),
        "CASE" to (30 to 0.00),
        "HEADPHONES" to (120 to 0.05)
    )

    val subtotal = items.values.sumOf { (price, _) -> price }
    assert(subtotal == 750)

    // 2. Nested destructuring in mapValues
    val taxes = items.mapValues { (_, (price, tax)) -> (price * tax).toInt() }
    val totalTax = taxes.values.sum()
    assert(totalTax == 66)

    val grandTotal = subtotal + totalTax
    val finalAmount = if (grandTotal > 700) grandTotal - 50 else grandTotal
    assert(finalAmount == 766)

    // 3. Keyword 'let' as alias of 'val'
    let singleVal = 100
    assert(singleVal == 100)

    let (firstItem, secondItem) = [10, 20]
    assert(firstItem == 10)
    assert(secondItem == 20)

    // 4. Utility function range()
    val r1 = range(5)
    assert(r1.size == 5)
    assert(r1[0] == 0 && r1[4] == 4)

    val r2 = range(2, 6)
    assert(r2.size == 4)
    assert(r2[0] == 2 && r2[3] == 5)

    val r3 = range(0, 10, 3)
    assert(r3.size == 4)
    // 5. Uninitialized val assigned in branches
    val units = 250
    val cost: Int
    if (units <= 100) {
        cost = 0
    } else if (units <= 200) {
        cost = (units - 100) * 1
    } else {
        cost = 100 + (units - 200) * 4
    }
    assert(cost == 300)

    // 6. Uninitialized var assigned later
    var deferredVar: Int
    deferredVar = 42
    deferredVar = deferredVar + 1
    assert(deferredVar == 43)

    println("Passed testDestructureLambdaAndMap")
}

testDestructureLambdaAndMap()
