// Global state to track forEach results
var globalArraySum = 0

// Named callback function for sort
fun arraySortValue(a: Int, b: Int): Int = when {
    a > b -> 1
    a == b -> 0
    else -> -1
}

fun testArrayFeaturesExhaustive() {
    // 1. Test: Explicit Constructor Array<Int>(), reserve, isEmpty, size
    val explicitArr = Array<Int>()
    explicitArr.reserve(10)
    assert(explicitArr.isEmpty() == true)
    assert(explicitArr.size() == 0)

    // 2. Test: Sugar Syntax, get, set, add
    val a = <Int>[5, 9, 12, 6, 3, 4]
    assert(a.size() == 6)
    assert(a.get(1) == 9)
    
    a.set(1, 10)
    assert(a.get(1) == 10)
    
    a.add(7)
    assert(a.get(6) == 7)

    // 3. Test: insert, indexOf, contains
    a.insert(2, 1)
    assert(a.get(2) == 1)
    assert(a.size() == 8)
    
    assert(a.indexOf(1) == 2)
    assert(a.indexOf(33) == -1) 
    assert(a.contains(12) == true)
    assert((99 in a) == false)

    // 4. Test: remove, pop
    a.remove(2)
    assert(a.get(2) == 12)
    
    val poppedValue = a.pop()
    assert(poppedValue == 7)
    assert(a.size() == 6)

    // 5. Test: forEach
    globalArraySum = 0
    a.forEach {|value|
		globalArraySum += value
	}
	a.forEach {|value, index|
		globalArraySum += value
	}
    assert(globalArraySum == 80)

    // 6. Test: sort
    a.sort(arraySortValue)
    assert(a.get(0) == 3)
    assert(a.get(5) == 12)

    // 7. Test: filter
    val filteredArr = a.filter {|value| value > 5}
    assert(filteredArr.size() == 3)
    assert(filteredArr.get(0) == 6)

    // 8. Test: slice
    val slicedArr = a.slice(1, 4)
    assert(slicedArr.size() == 3)
    assert(slicedArr.get(0) == 4)

    // 9. Test: toString
    val str = a.toString()
    assert(str is String)

    // 10. Test: clone, sorted, first, last, take, drop
    val c = a.clone()
    assert(c.size() == a.size())
    assert(c.first() == 3)
    assert(c.firstOrNull() == 3)
    assert(c.last() == 12)
    assert(c.lastOrNull() == 12)

    val s = <Int>[9, 1, 5, 2].sorted()
    assert(s.get(0) == 1 && s.get(1) == 2 && s.get(2) == 5 && s.get(3) == 9)

    val t = a.take(2)
    assert(t.size() == 2 && t.get(0) == 3 && t.get(1) == 4)

    val d = a.drop(4)
    assert(d.size() == 2 && d.get(0) == 10 && d.get(1) == 12)

    // 11. Test: any, all, none, count(fn)
    assert(a.any() == true)
    assert(a.any {|v| v == 10} == true)
    assert(a.any {|v| v == 999} == false)
    assert(a.all {|v| v > 0} == true)
    assert(a.all {|v| v > 5} == false)
    assert(a.none() == false)
    assert(a.none {|v| v < 0} == true)
    assert(a.none {|v| v == 3} == false)
    assert(a.count {|v| v >= 6} == 3)

    // 12. Test: map, mapIndexed, reduce, fold
    val doubled = a.map<Int>({|v: Int| v * 2 })
    assert(doubled.get(0) == 6 && doubled.get(5) == 24)

    val indexed = a.mapIndexed<Int>({|v: Int, idx: Int| v + idx })
    assert(indexed.get(0) == 3 && indexed.get(1) == 5)

    val sumAll = a.reduce({|acc: Int, v: Int| acc + v })
    assert(sumAll == 40)

    val foldVal = a.fold<Int>(10, {|acc: Int, v: Int| acc + v })
    assert(foldVal == 50)

    // 13. Clean up test
    a.clear()
    assert(a.isEmpty() == true)
    assert(a.size() == 0)
    assert(a.firstOrNull() == null)
    assert(a.lastOrNull() == null)
    assert(a.any() == false)
    assert(a.none() == true)

    // Only prints if all assertions pass
    println("Passed ${__FUNC__}")
}

// Execute the test
testArrayFeaturesExhaustive()