class TestMapFeaturesExhaustive {
	var mapKeySum = 0
	var mapValueSum = 0

	fun a() {
		mapKeySum = 999
	}

	fun testMapFeaturesExhaustive() {
		// 1. Test: Explicit Constructor, isEmpty, size
		val explicitMap = Map<String, Int>()
		assert(explicitMap.isEmpty() == true)
		assert(explicitMap.size() == 0)

		// 2. Test: Sugar Syntax, set, get, size
		val m = <String, Int>{"Apple": 10, "Banana": 20, "Cherry": 30}
		assert(m.size() == 3)
		assert(m.get("Banana") == 20)
		assert(m.get("Durian") == null) // Non-existent key returns null

		// 3. Test: Update existing key (set) and containsKey
		m.set("Apple", 15) // Update Apple from 10 to 15
		assert(m.get("Apple") == 15)
		assert(m.size() == 3) // Size remains unchanged
		
		assert(m.containsKey("Cherry") == true)
		assert(m.containsKey("Mango") == false)

		// 4. Test: remove
		m.remove("Banana")
		assert(m.get("Banana") == null)
		assert(m.containsKey("Banana") == false)
		assert(m.size() == 2) // Only Apple and Cherry remain

		// 5. Test: forEach (Create an Int, Int map for easy summation)
		val numMap = <Int, Int>{1: 100, 2: 200, 3: 300}
		mapKeySum = 0
		mapValueSum = 0
		numMap.forEach {|key, value|
			mapKeySum += key
			mapValueSum += value
		}
		// Total keys: 1 + 2 + 3 = 6
		// Total values: 100 + 200 + 300 = 600
		assert(mapKeySum == 6)
		assert(mapValueSum == 600)

		// 6. Test: keys() and values()
		val keysArr = numMap.keys()
		assert(keysArr is Array<Int>)
		assert(keysArr.size() == 3)
		assert(keysArr.contains(1) && keysArr.contains(2) && keysArr.contains(3))

		val valuesArr = numMap.values()
		assert(valuesArr is Array<Int>)
		assert(valuesArr.size() == 3)
		assert(100 in valuesArr && 200 in valuesArr && 300 in valuesArr)

		// 7. Test: toString
		val str = numMap.toString()
		assert(str is String)
		assert(str.size() > 0)

		// 8. Clean up test (clear)
		numMap.clear()
		assert(numMap.isEmpty() == true)
		assert(numMap.size() == 0)
		assert(numMap.containsKey(1) == false)

		// Only prints if all assertions pass
		println("Passed ${__FUNC__}")
	}

}


// Execute the test
TestMapFeaturesExhaustive().testMapFeaturesExhaustive()