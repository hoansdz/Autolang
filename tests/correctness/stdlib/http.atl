@import("std/http")

fun checkResponse(res: HttpResponse) {
    assert(res.status >= 100 && res.status < 600)
    assert(res.url != "")
    assert(res.headers.size() >= 0)
    assert(res.body.size() >= 0)
}

fun testHttpFeatures() {
    try {
        // Attempt a GET request. Even if it fails due to network issues (DNS/timeout),
        // we check that the exception is NOT a SecurityError.
        val res = Http.get("https://example.com", 2000)
        checkResponse(res)
        println("Http.get ok: ${res.ok}, status: ${res.status}, url: ${res.url}, body size: ${res.body.size()}")
    } catch (e) {
        val errStr = e.message
        assert(errStr.indexOf("SecurityError") == -1)
        println("Http.get bypassed security but failed with network/other error: ${errStr}")
    }

    try {
        val res = Http.post("https://example.com", "test body", 2000)
        checkResponse(res)
        println("Http.post ok: ${res.ok}, status: ${res.status}, url: ${res.url}, body size: ${res.body.size()}")
    } catch (e) {
        val errStr = e.message
        assert(errStr.indexOf("SecurityError") == -1)
        println("Http.post bypassed security but failed with network/other error: ${errStr}")
    }

    try {
        val res = Http.delete("https://example.com", 2000)
        checkResponse(res)
        println("Http.delete ok: ${res.ok}, status: ${res.status}, url: ${res.url}, body size: ${res.body.size()}")
    } catch (e) {
        val errStr = e.message
        assert(errStr.indexOf("SecurityError") == -1)
        println("Http.delete bypassed security but failed with network/other error: ${errStr}")
    }

    try {
        val urls = <String>["https://example.com", "https://httpbin.org/get"]
        val responses = Http.getAll(urls, 2000)
        assert(responses.size() == urls.size())
        checkResponse(responses.get(0))
        println("Http.getAll success, count: ${responses.size()}")
    } catch (e) {
        val errStr = e.message
        assert(errStr.indexOf("SecurityError") == -1)
        println("Http.getAll bypassed security but failed with network/other error: ${errStr}")
    }

    println("Passed ${__FUNC__}")
}

testHttpFeatures()
