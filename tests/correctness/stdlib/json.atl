@import ("std/json")

fun testJsonFeaturesExhaustive() {
    val rawText = "{\"name\": \"AutoLang\", \"version\": 1.0, \"isFast\": true, \"data\": null}"
    val obj = Json.parse(rawText)
    
    assert(obj.isObject() == true)
    assert(obj.getSize() == 4)
    assert(obj.has("name") == true)
    assert(obj.has("fake_key") == false)

    val nameField = obj.get("name")
    assert(nameField.isString() == true)
    assert(nameField.asString() == "AutoLang")

    val versionField = obj.get("version")
    assert(versionField.isNumber() == true)
    assert(versionField.asFloat() == 1.0)

    val fastField = obj.get("isFast")
    assert(fastField.isBool() == true)
    assert(fastField.asBool() == true)

    val dataField = obj.get("data")
    assert(dataField.isNull() == true)

    val newObj = Json.emptyObject()
    newObj.set("compiler", Json.fromString("C++"))
    newObj.set("threads", Json.fromInt(8))
    newObj.set("pi", Json.fromFloat(3.14))
    
    assert(newObj.getSize() == 3)
    assert(newObj["threads"].asInt() == 8)
    assert(newObj["pi"].asFloat() == 3.14)

    val arr = Json.emptyArray()
    arr.add(Json.fromInt(10))
    arr.add(Json.fromInt(20))
    arr.add(Json.fromInt(30))
    
    assert(arr.isArray() == true)
    assert(arr.getSize() == 3)
    assert(arr.getAt(0).asInt() == 10)
    assert(arr.getAt(2).asInt() == 30)

    val root = Json.emptyObject()
    root["list"] = arr
    root["meta"] = newObj
    
    assert(root.get("list").isArray() == true)
    assert(root.get("list").getAt(1).asInt() == 20)
    assert(root.get("meta").get("compiler").asString() == "C++")

    val jsonInts = Json.parse("[100, 200, 300]")
    val autoIntArray = jsonInts.toIntArray()
    assert(autoIntArray.size() == 3)
    assert(autoIntArray.get(1) == 200)

    val jsonFloats = Json.parse("[1.5, 2.5, 3.5]")
    val autoFloatArray = jsonFloats.toFloatArray()
    assert(autoFloatArray.size() == 3)
    assert(autoFloatArray.get(2) == 3.5)

    val jsonStrings = Json.parse("[\"apple\", \"banana\"]")
    val autoStringArray = jsonStrings.toStringArray()
    assert(autoStringArray.size() == 2)
    assert(autoStringArray[0] == "apple")

    val dumpTest = Json.emptyObject()
    dumpTest.set("key", Json.fromString("value"))
    
    val minifiedStr = dumpTest.stringify(-1)
    assert(minifiedStr == "{\"key\":\"value\"}")
    
    val prettyStr = dumpTest.stringify(4)
    assert(prettyStr.indexOf("\n") != -1)
    
    println("Passed ${__FUNC__}")
}

testJsonFeaturesExhaustive()