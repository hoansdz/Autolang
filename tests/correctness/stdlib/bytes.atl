@import("std/bytes")

fun testBytesFeaturesExhaustive() {
    val b = Bytes()
    assert(b.size() == 0)
    assert(b.isEmpty() == true)

    b.append(10)
    b.append(20)
    b.append(30)
    b.append(40)

    assert(b.size() == 4)
    assert(b.isEmpty() == false)
    assert(b.get(0) == 10)
    assert(b.get(3) == 40)

    b.set(1, 99)
    assert(b.get(1) == 99)

    val s = b.slice(1, 3)
    assert(s.size() == 2)
    assert(s.get(0) == 99)
    assert(s.get(1) == 30)

    val str = b.toString()
    assert(str == "[10, 99, 30, 40]")

    b.clear()
    assert(b.size() == 0)
    assert(b.isEmpty() == true)

    val b2 = Bytes.fromHex("deadbeef")
    assert(b2.size() == 4)
    assert(b2.toHex() == "deadbeef")

    val b3 = Bytes.fromBase64("SGVsbG8=")
    assert(b3.decodeToString() == "Hello")
    assert(b3.encodeBase64() == "SGVsbG8=")

    val arr = b2.toByteArray()
    assert(arr.size() == 4)
    assert(arr[0] == 222)

    val strBytes = "AutoLang".encodeToByteArray()
    assert(strBytes.decodeToString() == "AutoLang")

    // Bytes index operators
    val ba: Bytes = strBytes
    assert(ba[0] == 65) // 'A'
    ba[0] = 97          // 'a'
    assert(ba[0] == 97)
    assert(ba.decodeToString() == "autoLang")

    // Implicit constructor range validation (-128..255)
    val validBytes: ByteArray = [-128, 0, 255]
    assert(validBytes.size() == 3)
    assert(validBytes[0] == 128)
    assert(validBytes[1] == 0)
    assert(validBytes[2] == 255)

    var outOfRangeCaught = false
    try {
        val invalidBytes: ByteArray = [1, 2555]
    } catch (e: Exception) {
        outOfRangeCaught = e.message.contains("Byte value out of range: 2555")
    }
    assert(outOfRangeCaught)

    // copyOf and copyOfRange
    val copied = ba.copyOf()
    assert(copied.size() == ba.size())
    assert(copied.contentEquals(ba))
    val expanded = ba.copyOf(10)
    assert(expanded.size() == 10)
    assert(expanded[8] == 0 && expanded[9] == 0)
    val ranged = ba.copyOfRange(0, 4)
    assert(ranged.decodeToString() == "auto")

    // reversed and reverse
    val rev = ranged.reversed()
    assert(rev.decodeToString() == "otua")
    ranged.reverse()
    assert(ranged.decodeToString() == "otua")

    // contains, lastIndexOf, lastIndex, indices
    val sample = Bytes.fromString("banana")
    assert(sample.contains(97)) // 'a'
    assert(sample.contains(122) == false) // 'z'
    assert(sample.indexOf(97) == 1)
    assert(sample.lastIndexOf(97) == 5)
    assert(sample.lastIndex() == 5)
    val sampleIndices = sample.indices()
    assert(sampleIndices.size() == 6 && sampleIndices[5] == 5)

    // forEach and toList
    var sum = 0
    val numBytes = Bytes(3)
    numBytes[0] = 10
    numBytes[1] = 20
    numBytes[2] = 30
    numBytes.forEach { sum = sum + it }
    assert(sum == 60)
    val listBytes = numBytes.toList()
    assert(listBytes.size() == 3 && listBytes[1] == 20)

    // Endianness I/O: 16-bit, 32-bit, 64-bit, Float
    val ioBuf = Bytes(16)
    ioBuf.writeInt16LE(0, 0x1234)
    assert(ioBuf.readInt16LE(0) == 0x1234)
    ioBuf.writeInt16BE(2, 0x1234)
    assert(ioBuf.readInt16BE(2) == 0x1234)

    ioBuf.writeInt32LE(4, 0x12345678)
    assert(ioBuf.readInt32LE(4) == 0x12345678)

    ioBuf.writeInt64BE(8, 0x0102030405060708)
    assert(ioBuf.readInt64BE(8) == 0x0102030405060708)

    val floatBuf = Bytes(16)
    floatBuf.writeFloatLE(0, 3.14159)
    assert(abs(floatBuf.readFloatLE(0) - 3.14159) < 0.0001)
    floatBuf.writeFloatBE(8, 2.71828)
    assert(abs(floatBuf.readFloatBE(8) - 2.71828) < 0.0001)

    println("Passed testBytesFeaturesExhaustive")
}

testBytesFeaturesExhaustive()
