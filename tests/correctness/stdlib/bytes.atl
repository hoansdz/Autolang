@import("std/bytes")

fun testBytesFeaturesExhaustive() {
    val b = Bytes()
    assert(b.size() == 0)
    assert(b.isEmpty() == true)

    b.append(10)
    b.append(20)
    b.append(30)
    b.append(40)

    assert(b.size() == 4)
    assert(b.isEmpty() == false)
    assert(b.get(0) == 10)
    assert(b.get(3) == 40)

    b.set(1, 99)
    assert(b.get(1) == 99)

    val s = b.slice(1, 3)
    assert(s.size() == 2)
    assert(s.get(0) == 99)
    assert(s.get(1) == 30)

    val str = b.toString()
    assert(str == "[10, 99, 30, 40]")

    b.clear()
    assert(b.size() == 0)
    assert(b.isEmpty() == true)

    println("Passed testBytesFeaturesExhaustive")
}

testBytesFeaturesExhaustive()
