@import("std/date")

fun testDateFeatures() {
    // 1. Current timestamp
    val ms = Date.currentTimeMillis()
    assert(ms > 0)

    // 2. Constructors
    val dNow = Date.now()
    assert(dNow != null)

    // Create from a specific timestamp: 1704067200000 ms is 2024-01-01 00:00:00 UTC
    // Wait, let's test with a local timestamp or a known epoch timestamp.
    // e.g. 0 timestamp => 1970-01-01 local time
    val dEpoch = Date.fromTimestamp(0)
    assert(dEpoch.getTime() == 0)

    // 3. Date arithmetic
    val dTemp = Date.fromTimestamp(0)
    dTemp.addDays(1)
    assert(dTemp.getTime() == 24 * 60 * 60 * 1000)

    dTemp.addHours(1)
    assert(dTemp.getTime() == (24 * 60 * 60 * 1000) + (60 * 60 * 1000))

    dTemp.addMinutes(1)
    assert(dTemp.getTime() == (24 * 60 * 60 * 1000) + (60 * 60 * 1000) + (60 * 1000))

    dTemp.addSeconds(1)
    assert(dTemp.getTime() == (24 * 60 * 60 * 1000) + (60 * 60 * 1000) + (60 * 1000) + 1000)

    // 4. Leap year check
    // 2000 is leap year
    val dLeap = Date.fromTimestamp(946684800000) // 2000-01-01 UTC approx
    // Leap year check is timezone-independent for year 2000
    assert(dLeap.isLeapYear() == true)

    // 2001 is not leap year
    val dNotLeap = Date.fromTimestamp(978307200000) // 2001-01-01 UTC approx
    assert(dNotLeap.isLeapYear() == false)

    // 5. Formatting (Pattern like "%Y-%m-%d")
    val dFormat = Date.fromTimestamp(1704067200000) // 2024-01-01 approx (can be 2023 or 2024 depending on timezone, so let's format it and assert format is not empty)
    val str = dFormat.format("%Y")
    assert(str == "2024" || str == "2023")

    // 6. Factory constructors
    val dCtor = Date()
    assert(dCtor != null)
    assert(dCtor.getTime() > 0)

    val dCtorTs = Date(1000)
    assert(dCtorTs.getTime() == 1000)

    // 7. Day of week & Day of year
    assert(dCtor.dayOfWeek() >= 0 && dCtor.dayOfWeek() <= 6)
    assert(dCtor.dayOfYear() >= 1 && dCtor.dayOfYear() <= 366)

    // 8. Parse
    val dParsed = Date.parse("2024-05-20 14:30:00")
    assert(dParsed.year() == 2024)
    assert(dParsed.month() == 5)
    assert(dParsed.day() == 20)
    assert(dParsed.hour() == 14)
    assert(dParsed.minute() == 30)
    assert(dParsed.second() == 0)

    // 9. Comparison, diff, clone
    assert(dParsed.isAfter(dEpoch) == true)
    assert(dEpoch.isBefore(dParsed) == true)
    assert(dParsed.diff(dEpoch) > 0)

    val dCopy = dParsed.copy()
    assert(dCopy.getTime() == dParsed.getTime())

    // 10. String conversions
    val parsedStr = dParsed.toString()
    assert(parsedStr == "2024-05-20 14:30:00")
    assert(dParsed.toDateString() == "2024-05-20")
    assert(dParsed.toTimeString() == "14:30:00")
    assert(dParsed.toISOString() == "2024-05-20T14:30:00")

    println("Passed ${__FUNC__}")
}

testDateFeatures()
