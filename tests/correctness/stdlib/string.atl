fun testStringFeatures() {
    // 1. Constructors
    val s1 = String()
    assert(s1 == "")
    assert(s1.size() == 0)
    assert(s1.isEmpty())

    val s2 = String("hello")
    assert(s2 == "hello")
    assert(s2.size() == 5)
    assert(s2.isEmpty() == false)

    val s3 = String("ab", 3)
    assert(s3 == "ababab")
    assert(s3.size() == 6)

    // 2. Conversion
    val i1 = 123
    val f1 = 45.67
    assert(i1.toString() == "123")
    assert(f1.toString().contains("45.67"))

    val sInt = "456"
    val sFloat = "123.45"
    assert(sInt.toInt() == 456)
    assert(sFloat.toFloat() == 123.45)

    // 3. Accessors
    val s4 = "abcdef"
    assert(s4.get(0) == "a")
    assert(s4.get(2) == "c")
    assert(s4.get(-1) == "f") // Negative index support
    assert(s4.charAt(0) == 97) // 'a' ASCII is 97
    assert(s4.charAt(1) == 98) // 'b' ASCII is 98

    // 4. Substring
    assert(s4.substr(2) == "cdef")
    assert(s4.substr(-2) == "ef")
    assert(s4.substr(1, 3) == "bcd")

    // 5. Query and Manipulation
    val s5 = "  hello world  \n\t"
    assert(s5.trim() == "hello world")

    val s6 = "quick brown fox"
    assert(s6.contains("brown"))
    assert(s6.contains("green") == false)
    assert(s6.indexOf("brown") == 6)
    assert(s6.indexOf("green") == -1)

    val replaced = s6.replace("brown", "red")
    assert(replaced == "quick red fox")

    // 6. Split
    val parts = "one,two,three".split(",")
    assert(parts.size() == 3)
    assert(parts[0] == "one")
    assert(parts[1] == "two")
    assert(parts[2] == "three")

    println("Passed ${__FUNC__}")
}

testStringFeatures()
