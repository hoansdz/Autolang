fun testStringFeatures() {
    // 1. Constructors
    val s1 = String()
    assert(s1 == "", __FILE__, __LINE__)
    assert(s1.size() == 0, __FILE__, __LINE__)
    assert(s1.isEmpty(), __FILE__, __LINE__)

    val s2 = String("hello")
    assert(s2 == "hello", __FILE__, __LINE__)
    assert(s2.size() == 5, __FILE__, __LINE__)
    assert(s2.isEmpty() == false, __FILE__, __LINE__)

    val s3 = String("ab", 3)
    assert(s3 == "ababab", __FILE__, __LINE__)
    assert(s3.size() == 6, __FILE__, __LINE__)

    // 2. Conversion
    val i1 = 123
    val f1 = 45.67
    assert(i1.toString() == "123", __FILE__, __LINE__)
    assert(f1.toString().contains("45.67"), __FILE__, __LINE__)

    val sInt = "456"
    val sFloat = "123.45"
    assert(sInt.toInt() == 456, __FILE__, __LINE__)
    assert(sFloat.toFloat() == 123.45, __FILE__, __LINE__)

    // 3. Accessors
    val s4 = "abcdef"
    assert(s4.get(0) == "a", __FILE__, __LINE__)
    assert(s4.get(2) == "c", __FILE__, __LINE__)
    assert(s4.get(-1) == "f", __FILE__, __LINE__) // Negative index support
    assert(s4.charAt(0) == 97, __FILE__, __LINE__) // 'a' ASCII is 97
    assert(s4.charAt(1) == 98, __FILE__, __LINE__) // 'b' ASCII is 98

    // 4. Substring
    assert(s4.substr(2) == "cdef", __FILE__, __LINE__)
    assert(s4.substr(-2) == "ef", __FILE__, __LINE__)
    assert(s4.substr(1, 3) == "bcd", __FILE__, __LINE__)

    // 5. Query and Manipulation
    val s5 = "  hello world  \n\t"
    assert(s5.trim() == "hello world", __FILE__, __LINE__)

    val s6 = "quick brown fox"
    assert(s6.contains("brown"), __FILE__, __LINE__)
    assert(s6.contains("green") == false, __FILE__, __LINE__)
    assert(s6.indexOf("brown") == 6, __FILE__, __LINE__)
    assert(s6.indexOf("green") == -1, __FILE__, __LINE__)

    val replaced = s6.replace("brown", "red")
    assert(replaced == "quick red fox", __FILE__, __LINE__)

    // 6. Split
    val parts = "one,two,three".split(",")
    assert(parts.size() == 3, __FILE__, __LINE__)
    assert(parts[0] == "one", __FILE__, __LINE__)
    assert(parts[1] == "two", __FILE__, __LINE__)
    assert(parts[2] == "three", __FILE__, __LINE__)

    println("Passed ${__FUNC__}")
}

testStringFeatures()
