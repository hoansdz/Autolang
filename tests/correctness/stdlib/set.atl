// Global state to track forEach results since we don't have lambdas/closures
var globalSum = 0

// Named callback function to pass into forEach
fun accumulateSum(value: Int) {
    globalSum += value
}

// Helper function to test nested sets
fun testNestedSetSyntax(data: Set<Set<Int>>) {
    assert(data.size() == 2)
}

fun testAllSetFeatures() {

    // 1. Test: __CLASS__() explicit constructor (and private create)
    val explicitSet = Set<Int>()
    explicitSet.add(100)
    assert(explicitSet.size() == 1)
    assert(explicitSet.contains(100) == true)

    // 2. Test: insert, size, isEmpty
    val s1 = Set<Int>()
    s1.add(1)
    s1.add(2)
    s1.add(3)
    s1.add(4)
    s1.add(5)
    s1.add(5)
    s1.add(4)
    s1.add(3)
    s1.add(2)
    s1.add(1)
    assert(s1.size() == 5)
    assert(s1.isEmpty() == false)

    // 3. Test: contains
    val s2 = Set<String>()
    s2.add("Apple")
    s2.add("Banana")
    s2.add("Orange")
    s2.add("Apple") // Duplicate, should be ignored
    assert(s2.contains("Orange") == true)
    assert(s2.contains("Grapes") == false)

    // 4. Test: remove and clear
    s2.remove("Banana")
    assert(s2.size() == 2)
    assert(s2.contains("Banana") == false)
    
    s2.clear()
    assert(s2.size() == 0)
    assert(s2.isEmpty() == true)

    // 5. Test: forEach (using a named function callback)
    val s3 = Set<Int>()
    s3.add(10)
    s3.add(20)
    s3.add(30)
    globalSum = 0 // Reset global state
    s3.forEach(accumulateSum) // Passing the function by name
    assert(globalSum == 60)

    // 6. Test: toArray (Public and Private)
    val s4 = Set<String>()
    s4.add("X")
    s4.add("Y")
    s4.add("Z")
    val arr = s4.toArray()
    assert(arr is Array<String>)
    assert(arr.size() == 3)
    assert(arr.contains("X") && arr.contains("Y") && arr.contains("Z"))

    // 7. Test: union, intersect, difference
    val setA = Set<Int>()
    setA.add(1)
    setA.add(2)
    setA.add(3)
    setA.add(4)

    val setB = Set<Int>()
    setB.add(3)
    setB.add(4)
    setB.add(5)
    setB.add(6)

    val unionSet = setA.union(setB)
    assert(unionSet.size() == 6)

    val intersectSet = setA.intersect(setB)
    assert(intersectSet.size() == 2)
    assert(intersectSet.contains(3) && intersectSet.contains(4))

    val diffSet = setA.difference(setB)
    assert(diffSet.size() == 2)
    assert(diffSet.contains(1) && !diffSet.contains(3))

    // 8. Test: toString
    val str = s3.toString()
    assert(str is String)

    // 9. Test: Nested Sets
    val subSet1 = Set<Int>()
    subSet1.add(1)
    subSet1.add(2)
    val subSet2 = Set<Int>()
    subSet2.add(3)
    subSet2.add(4)
    val nestedSet = Set<Set<Int>>()
    nestedSet.add(subSet1)
    nestedSet.add(subSet2)
    testNestedSetSyntax(nestedSet)

    // 10. Test: clone, filter, map, first, firstOrNull, any, all, none
    val originalSet = Set<Int>()
    originalSet.add(10)
    originalSet.add(20)
    originalSet.add(30)
    val clonedSet = originalSet.clone()
    assert(clonedSet.size() == 3)
    assert(clonedSet.contains(10) && clonedSet.contains(20) && clonedSet.contains(30))

    val filteredSetTest = originalSet.filter {v-> v > 15}
    assert(filteredSetTest.size() == 2)
    assert(filteredSetTest.contains(20) && filteredSetTest.contains(30) && !filteredSetTest.contains(10))

    val mappedArrTest = originalSet.map<Int>({|v: Int| v * 2 })
    assert(mappedArrTest is Array<Int>)
    assert(mappedArrTest.size() == 3)

    assert(originalSet.firstOrNull() != null)
    assert(originalSet.any() == true)
    assert(originalSet.any {|v| v == 20} == true)
    assert(originalSet.any {|v| v == 99} == false)
    assert(originalSet.all {|v| v >= 10} == true)
    assert(originalSet.all {|v| v > 20} == false)
    assert(originalSet.none() == false)
    assert(originalSet.none {|v| v < 0} == true)
    assert(originalSet.none {|v| v == 20} == false)

    val emptySet = Set<Int>()
    assert(emptySet.isEmpty() == true)
    assert(emptySet.firstOrNull() == null)
    assert(emptySet.any() == false)
    assert(emptySet.none() == true)

    println("Passed ${__FUNC__}")
}

// Execute the test
testAllSetFeatures()