fun quickSort(arr: Array<Int>, left: Int, right: Int) {
	if (left >= right) return
	val pivot = (left + right) / 2
	val partition = arr[pivot]

	var i = 0
	var j = 0
	while (i < j) {
		while (arr[i] < partition) {
			i += 1
		}
		while (arr[j] > partition) {
			j -= 1
		}
		if (i <= j) {
			val temp = arr[i]
			arr[i] = arr[j]
			arr[j] = temp
			i += 1
			j -= 1
		}
	}
	if (i < right) {
		quickSort(arr, i, right)
	}
	if (j > left) {
		quickSort(arr, left, j)
	}
}


val arr_ = <Int>[1, 2, 5, 1, 5, 7, 9]
quickSort(arr_, 0, arr_.size() - 1)
println(arr_)
	
class Box<T>(var value: T, val x: Box<Float>?)
val a = Box<Int>(5, Box<Float>(5, null))
println(a)
