@no_extends
@no_constructor
class Int {
	@native("to_string")
	fun toString(): String
}
@no_extends
@no_constructor
class Float {
	@native("to_string")
	fun toString(): String
}
@no_extends
@no_constructor
class Bool {
	
}
@no_extends
@no_constructor
class String {
	@native("string_constructor")
	static fun String(): String
	
	@native("string_constructor")
	static fun String(str: String): String

	@native("string_constructor")
	static fun String(str: String, repeatTimes: Int): String

	@native("string_size")
	fun size(): Int

	@native("str_is_empty")
	fun isEmpty(): Bool

	@native("str_to_int")
	fun toInt(): Int

	@native("str_to_float")
	fun toFloat(): Float

	@native("str_get")
	fun get(position: Int): String

	// @native("str_set")
	// fun set(position: Int, chr: Int)

	// @native("str_set")
	// fun set(position: Int, str: String)

	@native("str_char_at")
	fun charAt(position: Int): Int

	@native("str_substr")
	fun substr(from: Int): String

	@native("str_substr")
	fun substr(from: Int, length: Int): String

	@native("str_trim")
	fun trim(): String

	@native("str_contains")
	fun contains(sub: String): Bool

	@native("str_index_of")
	fun indexOf(sub: String): Int

	@native("str_split")
	fun split(delimiter: String, classId: Int = getClassId(Array<String>)): Array<String>

	@native("str_replace")
	fun replace(old: String, new: String): String
}

@no_constructor
@no_extends
class Bytes {
    @native("bytes_constructor")
    static fun Bytes(initialSize: Int = 0): Bytes

	// @native("bytes_resize")
	// fun resize(size: Int)

    @native("bytes_append")
    fun append(value: Int)

    @native("bytes_size")
    fun size(): Int

    @native("bytes_is_empty")
    fun isEmpty(): Bool

    @native("bytes_get")
    fun get(index: Int): Int

    @native("bytes_set")
    fun set(index: Int, value: Int)

    @native("bytes_clear")
    fun clear()

    @native("bytes_slice")
    fun slice(from: Int, to: Int): Bytes

    @native("bytes_to_string")
    fun toString(): String
}

