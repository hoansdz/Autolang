}


class Exception(val message: String) {
	
}

@no_constructor
@no_extends
class Array<T> {

	static fun __CLASS__(): Array<T> = <T>[]

	@native("arr_add")
	fun add(value: T)

	@native("arr_remove")
	fun remove(index: Int)

	@native("arr_size")
	fun size(): Int

	@native("arr_is_empty")
	fun isEmpty(): Bool

	@native("arr_get")
	fun get(index: Int): T

	@native("arr_set")
	fun set(index: Int, value: T)

	@native("arr_clear")
	fun clear()

	@native("arr_contains")
	fun contains(value: T): Bool

	@native("arr_for_each")
	fun forEach(fn: (T) -> Void)

	@native("arr_filter")
	fun filter(fn: (T) -> Bool): Array<T>

	@native("arr_sort")
	fun sort(comparator: (T, T) -> Int)

	@native("arr_slice")
	fun slice(from: Int, to: Int): Array<T>

	@native("arr_index_of")
	fun indexOf(value: T): Int

	@native("arr_reserve")
	fun reserve(capacity: Int)

	@native("arr_pop")
	fun pop(): T?

	@native("arr_insert")
	fun insert(index: Int, value: T)

	@native("arr_to_string")
	fun toString(): String
}

@no_extends
@no_constructor
class Set<T> {
	static fun __CLASS__(): Set<T> = <T>{}

	@native("set_add")
	fun add(value: T)

	@native("set_remove")
	fun remove(value: T)

	@native("set_size")
	fun size(): Int

	@native("set_contains")
	fun contains(value: T): Bool

	@native("set_clear")
	fun clear()

	@native("set_is_empty")
    fun isEmpty(): Bool

    @native("set_for_each")
    fun forEach(fn: (T) -> Void)

    @native("set_to_array")
    fun toArray(classId: Int = getClassId(Array<T>)): Array<T>

	@native("set_union")
    fun union(other: Set<T>): Set<T>

    @native("set_intersect")
    fun intersect(other: Set<T>): Set<T>

    @native("set_difference")
    fun difference(other: Set<T>): Set<T>
	
	@native("set_to_string")
	fun toString(): String
}

@no_extends
@no_constructor
class Map<K, V> {
	static fun __CLASS__(): Map<K, V> = <K, V>{}
	
	@native("map_get")
	fun get(key: K): V?

	@native("map_get_or_default")
	fun getOrDefault(key: K, defaultValue: V): V
	
	@native("map_set")
	fun set(key: K, value: V)

	@native("map_is_empty")
    fun isEmpty(): Bool

    @native("map_contains_key")
    fun containsKey(key: K): Bool

	@native("map_size")
	fun size(): Int

	@native("map_for_each")
    fun forEach(fn: (K, V) -> Void)

	@native("map_keys")
    fun keys(classId: Int = getClassId(Array<K>)): Array<K>

	@native("map_values")
    fun values(classId: Int = getClassId(Array<V>)): Array<V>

	@native("map_remove")
	fun remove(key: K)

	@native("map_clear")
	fun clear()

	@native("map_to_string")
	fun toString(): String
}
	
@native("print")
fun print(value: Any? = "")
@native("println")
fun println(value: Any? = "")
@native("get_refcount")
fun getRefCount(value: Any?): Int
fun assert(condition: Bool, fileName: String, line: Int) {
	if (condition) {
		return
	}
	throw Exception("${fileName}:${line}: Wrong")
}
